metric:RespirationVolume_Minute a skos:Concept ;
    rdfs:subClassOf metric:RespirationVolume ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( metric:RespirationVolume [ a owl:Restriction ;
                        owl:hasValue metricAggregation:Minute ;
                        owl:onProperty mda:hasAggregation ] ) ] ;
    skos:broader metric:RespirationVolume ;
    skos:inScheme metric:Scheme ;
    skos:notation "RespirationVolume_Minute" ;
    skos:prefLabel "Respiration Volume_Minute"@en ;
    mda:hasAggregation metricAggregation:Minute .

metric:RespirationVolume_Tidal a skos:Concept ;
    rdfs:subClassOf metric:RespirationVolume ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( metric:RespirationVolume [ a owl:Restriction ;
                        owl:hasValue metricAggregation:Tidal ;
                        owl:onProperty mda:hasAggregation ] ) ] ;
    skos:broader metric:RespirationVolume ;
    skos:inScheme metric:Scheme ;
    skos:notation "RespirationVolume_Tidal" ;
    skos:prefLabel "Respiration Volume_Tidal"@en ;
    mda:hasAggregation metricAggregation:Tidal .

