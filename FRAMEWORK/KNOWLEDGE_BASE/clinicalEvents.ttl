####################################################################
# clinicalEvents.ttl — HAND-AUTHORED. NOT GENERATED.
#
# The framework's EVIDENCE CRITERIA for clinical events: for each kind of
# mda:ClinicalEvent, what it must be evidenced by. Kept apart from
# inference.ttl because it is a different kind of knowledge — inference.ttl
# interprets an alarm's own technical and clinical content; this file says
# which of that content is grounds for a discrete clinical judgement about
# a patient.
#
# SHAPE — one axiom per event, on the event class itself
# --------------------------------------------------------------------
# Each clinical-event concept is also an OWL class (rdfs:subClassOf
# mda:ClinicalEvent, clinicalEvent_vocab.ttl). Its criterion is stated as a
# necessary condition on that class:
#
#   clinicalEvent:CardiacArrest rdfs:subClassOf
#       [ evidencedBy some ( metric:HeartRate and hasRhythm value Absent ) ]
#
# read as: "a cardiac arrest is evidenced by a heart-rate metric whose
# rhythm is absent". The only arrow is event -> evidence (mda:evidencedBy);
# nothing points from evidence back to the event.
#
# WHAT THESE AXIOMS DO NOT DO
# --------------------------------------------------------------------
# They never create an event. OWL cannot mint an individual, and an
# existential on the right-hand side of rdfs:subClassOf is outside the
# OWL 2 RL profile, so an RL reasoner derives nothing from this file. That
# is intended: an event is minted by an application (the RDFox POC,
# MDA-POC-RDFox/), which implements each criterion as a query and gives the
# event its patient, evidence and times. These axioms are the reference
# that implementation is checked against, and what a competency question
# can read to ask which evidence leads to which event.
#
# rdfs:subClassOf, deliberately not owl:equivalentClass: a DL reasoner must
# never classify an event as a cardiac arrest merely because it has such
# evidence. Only the application assigns an event its kind.
#
# WHAT OWL CANNOT STATE, AND THE APPLICATION MUST ENFORCE
# --------------------------------------------------------------------
#   - Same patient. Every piece of evidence belongs to the patient the
#     event concerns (mda:concernsPatient). For a combined event, both
#     constituent events concern the same patient.
#   - Currency. Evidence supports an event only while it is currently
#     reported (for an alarm: while that alarm is valid). The event holds
#     from the moment its criterion first held (mda:hasStart) until the
#     moment it stopped holding (mda:hasEnd) — the latter is never the
#     moment an application noticed.
#   - Overlap. A combined event holds only while its constituents overlap
#     in time.
#   - Per-alarm evidence. Evidence is always a node minted for the alarm
#     that reported it, never a shared vocabulary concept.
#
# HISTORY — 2026-09 curation round
# --------------------------------------------------------------------
# This file used to define condition classes (mda:CardiacArrestCondition,
# ...) whose members were tagged mda:impliesClinicalEvent. That property is
# removed (see ontology.ttl's REMOVED note): it pointed from the evidence
# to the event, so the event had no node and no patient of its own, and a
# tag on a shared concept leaked across patients. The criteria also moved
# with the vocabulary: an absent rate is now mda:hasRhythm
# metricRhythm:Absent, a decreased one mda:hasValueState
# metricValueState:Decreased (the former mda:hasRate is gone).
####################################################################

@prefix mda:              <https://w3id.org/mda/ontology#> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix metric:           <https://w3id.org/mda/vocab/metric/> .
@prefix metricValueState: <https://w3id.org/mda/vocab/metric-value-state/> .
@prefix metricRhythm:     <https://w3id.org/mda/vocab/metric-rhythm/> .
@prefix qualitystate:     <https://w3id.org/mda/vocab/quality-state/> .
@prefix therapeuticModality: <https://w3id.org/mda/vocab/therapeutic-modality/> .
@prefix clinicalEvent:    <https://w3id.org/mda/vocab/clinical-event/> .

####################################################################
# Single-alarm events — evidenced by a metric
####################################################################

# Cardiac arrest: a heart-rate metric reporting an absent rhythm.
# Real corpus archetypes carry this on HeartRate (asystole alarms).
clinicalEvent:CardiacArrest rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty mda:evidencedBy ;
    owl:someValuesFrom
      [ a owl:Class ;
        owl:intersectionOf ( metric:HeartRate
          [ a owl:Restriction ; owl:onProperty mda:hasRhythm ; owl:hasValue metricRhythm:Absent ] ) ] ] .

# Respiratory arrest: a respiration-rate metric reporting an absent rhythm.
# Real corpus archetype: "PHILIPSMONITOR - Apneu".
clinicalEvent:RespiratoryArrest rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty mda:evidencedBy ;
    owl:someValuesFrom
      [ a owl:Class ;
        owl:intersectionOf ( metric:RespirationRate
          [ a owl:Restriction ; owl:onProperty mda:hasRhythm ; owl:hasValue metricRhythm:Absent ] ) ] ] .

# Reduced pulmonary function: a DECREASED MINUTE ventilation volume.
# Deliberately metric:RespirationVolume_Minute, not the broader
# metric:RespirationVolume, which would also admit a low tidal volume
# ("DATEXOHMEDACOMVENTILATOR - VTexp Low"). A low tidal volume alone can be
# rate-compensated; minute ventilation (rate x tidal volume) is the
# textbook marker of inadequate ventilation.
# Real corpus archetype: "MEDIBUS - MV ondergrens".
clinicalEvent:ReducedPulmonaryFunction rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty mda:evidencedBy ;
    owl:someValuesFrom
      [ a owl:Class ;
        owl:intersectionOf ( metric:RespirationVolume_Minute
          [ a owl:Restriction ; owl:onProperty mda:hasValueState ; owl:hasValue metricValueState:Decreased ] ) ] ] .

####################################################################
# Combined events — evidenced by other events (and a therapy)
#
# Two separate existentials, one per required piece of evidence: the
# event needs BOTH. Same patient and temporal overlap cannot be stated
# here; see the header.
####################################################################

# Cardiorespiratory arrest: a cardiac arrest and a respiratory arrest of
# the same patient, at the same time. The MDA-POC's CAT3a. Strict by
# design (decided 2026-09-21): both constituents are ABSENT-rhythm
# conditions (asystole, apnoea) and must hold simultaneously — no
# tolerance window. This departs from the original NL rule table ("reduced
# heart rate + reduced respiratory rate within 60 s -> respiratory
# arrest") in favour of clinical fidelity; see MDA-POC-RDFox/engine/
# clinical_events.py (EVENT_RULES) for the clause-by-clause account.
clinicalEvent:CardioRespiratoryArrest rdfs:subClassOf
  [ a owl:Restriction ; owl:onProperty mda:evidencedBy ; owl:someValuesFrom clinicalEvent:CardiacArrest ] ,
  [ a owl:Restriction ; owl:onProperty mda:evidencedBy ; owl:someValuesFrom clinicalEvent:RespiratoryArrest ] .

# Ventilation failure: reduced pulmonary function, and the patient's
# mechanical ventilation therapy compromised, at the same time. The MDA-POC's
# CAT3b (decided 2026-09-21). The original NL rule reads "alarms conveying
# [mechanical ventilation alarm, reduced function of pulmonary processes]
# within a 180s timeframe"; implemented as:
#   - "mechanical ventilation alarm": the ventilation THERAPY is compromised
#     (mda:hasTherapyDeliveryQuality qualitystate:Impaired on
#     therapeuticModality:VentilationTherapy). inference.ttl derives that
#     from a circuit leak, a malfunctioning ventilator or a disconnected
#     patient circuit. It replaces the former "ventilator in a fault state"
#     (Disabled, Disconnected, Malfunction, Warning): device-level
#     Disconnected is also what a lost data link or mains power yields, and
#     neither stops ventilation.
#   - "reduced function of pulmonary processes": ReducedPulmonaryFunction,
#     i.e. a decreased minute volume — strict on purpose.
#   - "within 180 s": both hold at the same time, as for CAT3a. Real data
#     showed that the former 15-minute carry-over of a device fault only
#     ever joined a ventilator swap (patient disconnected from one
#     ventilator, low minute volume on the next).
# The evidence is the modality node: the claim is about the therapy the
# patient receives, whichever device delivers it.
clinicalEvent:VentilationFailure rdfs:subClassOf
  [ a owl:Restriction ; owl:onProperty mda:evidencedBy ; owl:someValuesFrom clinicalEvent:ReducedPulmonaryFunction ] ,
  [ a owl:Restriction ;
    owl:onProperty mda:evidencedBy ;
    owl:someValuesFrom
      [ a owl:Class ;
        owl:intersectionOf ( therapeuticModality:VentilationTherapy
          [ a owl:Restriction ; owl:onProperty mda:hasTherapyDeliveryQuality ; owl:hasValue qualitystate:Impaired ] ) ] ] .
