# question: Can alarms from different manufacturers using different labels be recognized as conveying the same meaning?
#
# Strictest of the seven: two alarms "convey the same meaning" here only if
# their ENTIRE asserted content matches -- category, and every node's
# identity (rdf:type) and value (hasQualityState/hasRate/hasComponent-
# OperationState/hasSensorOperationState/hasDeviceOperationState/
# hasAnatomicalPosition/hasPhase/hasRhythm) along the full technical chain
# from the device down, not just a shared endpoint the way CQ2/CQ4/CQ6 test.
# Same method as the retired CQ5-style "identical semantic content" check,
# now restricted to groups spanning more than one hasManufacturer value.
#
# mda:hasPriority is deliberately EXCLUDED from the signature. Priority is
# an operational/triage attribute imposed on top of an alarm's meaning (how
# urgently to respond), not part of what it clinically or technically
# represents -- two "SpO2 is low" alarms mean the same thing whether one
# site's threshold flags it Medium and another's flags it Hoog. Verified
# this matters: including hasPriority drops the genuinely clean "Monitor -
# Lage SpO2" (Draeger) / "PHILIPSMONITOR - SpO2 laag" (Philips) pair from
# the result purely because they sit at different priority tiers, which
# would be the wrong call for a "same meaning" question (it is the right
# call for a stricter "identical alarm record" question, which this isn't).
#
# HAVING requires signature size > 2 (i.e. more than just hasCategory + the
# device's own class) to exclude sparse false positives: "HULBUS - 345" and
# "TRILOGY - 0x79" match on full signature but ONLY because neither has been
# annotated beyond device class and category -- two unresolved vendor error
# codes, not a genuine equivalence claim. Logged in ../cq_discoveries.md;
# not treated as a CQ7 result.
#
# Asserted only -- no inference.ttl predicate is involved (the signature is
# built entirely from kg_generated.ttl's own asserted structure), so this
# does not require the OWL-RL closure.

PREFIX mda: <https://w3id.org/mda/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT (GROUP_CONCAT(DISTINCT ?label; separator=" | ") AS ?alarms)
       (GROUP_CONCAT(DISTINCT ?manufacturer; separator=" | ") AS ?manufacturers)
       (COUNT(DISTINCT ?manufacturer) AS ?manufacturerCount)
       (COUNT(DISTINCT ?a) AS ?matchCount) WHERE {
  {
    SELECT ?a ?label ?manufacturer
           (GROUP_CONCAT(DISTINCT ?fact; separator="^") AS ?signature)
           (COUNT(DISTINCT ?fact) AS ?sigSize) WHERE {
      ?a a mda:AlarmType ; mda:hasLabel ?label .
      OPTIONAL { ?a mda:hasMessage/mda:triggeredBy/mda:hasManufacturer ?manufacturer . }
      {
        ?a mda:hasCategory ?v .
        BIND(CONCAT("hasCategory=", STR(?v)) AS ?fact)
      } UNION {
        ?a mda:hasMessage/mda:triggeredBy/(mda:hasFunctionalUnit|mda:hasComponent|mda:hasSensor|mda:sensorProducesSignal|mda:analyzedBy|mda:producesMetric)* ?node .
        ?node rdf:type ?t . ?t a skos:Concept .
        BIND(CONCAT("type=", STR(?t)) AS ?fact)
      } UNION {
        ?a mda:hasMessage/mda:triggeredBy/(mda:hasFunctionalUnit|mda:hasComponent|mda:hasSensor|mda:sensorProducesSignal|mda:analyzedBy|mda:producesMetric)* ?node .
        ?node ?p ?v .
        FILTER(?p IN (mda:hasQualityState, mda:hasRate, mda:hasComponentOperationState,
                       mda:hasSensorOperationState, mda:hasDeviceOperationState,
                       mda:hasAnatomicalPosition, mda:hasPhase, mda:hasRhythm))
        BIND(CONCAT(STRAFTER(STR(?p), "#"), "=", STR(?v)) AS ?fact)
      }
    }
    GROUP BY ?a ?label ?manufacturer
  }
}
GROUP BY ?signature
HAVING (COUNT(DISTINCT ?a) > 1 && COUNT(DISTINCT ?manufacturer) > 1 && SAMPLE(?sigSize) > 2)
ORDER BY DESC(?matchCount)
