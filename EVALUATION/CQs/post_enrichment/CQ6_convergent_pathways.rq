# question: Can alarms with different technical pathways provide information about the same clinical concept?
# rationale: Groups alarms by ORGAN (the clinical concept reached via
#   .../approximates/isPropertyOf/presentIn) and keeps the organs reached
#   through more than one distinct technical pathway, identifying genuine
#   multi-modal convergence rather than repeated measurements along a
#   single pathway.
#
# reasoning: required
#
# Three parts, each read from the graph that can answer it (cq_QA.py's
# reasoned_dataset(): the OWL-RL closure is the default graph, the asserted
# graph is the named graph <https://w3id.org/mda/graph/asserted>):
#
#   1. Pathway identity -- ASSERTED graph. Exactly CQ2's: the set of edges
#      (type of parent, property, type of child) below the alarm's
#      functional unit, unbounded depth, compared by counting; each alarm
#      gets the smallest IRI of its equivalence class as ?rep. A step with
#      several inputs (impedance respiration from RA + LA) is one pathway.
#      Read from the asserted graph because the closure cannot tell an
#      asserted type from an entailed one: there a node typed
#      metric:AirwayPressure_Peak is also metric:AirwayPressure, and OWL-RL
#      entails sibling pre-coordinated types (RespirationVolume_Tidal on a
#      ..._Tidal_Expiratory node) through hasValue restrictions without
#      entailing the subclass edge, so not even "most specific type" works.
#      The previous version keyed on (FU, sensor, metric) per sensor node in
#      the closure and so counted entailed superclasses and each electrode
#      as pathways of their own: Lungs 13 instead of 9 at p75.
#
#   2. Organ -- REASONED graph. The alarm's OWN metric (reached through any
#      number of derivation steps, the one no further step consumes) ->
#      approximates -> isPropertyOf -> presentIn. Needs the closure: at p75
#      41 (alarm, organ) pairs without it, 62 with it.
#
#   3. Only a defined measurement counts -- ASSERTED graph. The own metric
#      must carry a metric type. Rows that annotate a PhysiologicalProperty
#      without a Metric get an untyped metric node with an approximates edge
#      (build_framework.py's "[WARN] approximates" list; at p75 "MEDIBUS -
#      Drukbegrensd", "DATEXOHMEDACOMVENTILATOR - Plimit Reached",
#      "PHILIPSMONITOR - ABP verkleinen"). They stay organ-relevant in
#      CQ3/CQ4, but a "pathway" without a defined measurement is no pathway
#      that converges on anything (decided in the CQ review of 2026-11-25).
#
# distinctPathways = number of distinct ?rep among the alarms reaching the
# organ; matchCount = number of those alarms.
#
# Measurement convergence only: alarms that reach an organ purely through
# the therapeutic route (device administers a therapy, no metric) have no
# technical pathway to compare and are out of scope here (CQ3 covers them).
#
# Validated 2026-11-25 against a Python ground truth (edge sets grouped on
# the asserted graph, organs from the closure): exact on p75 and p99.
# p75: Lungs 9 pathways / 32 alarms, Heart 5 / 15, BloodVessels 4 / 9.
# The p75 and p99 closures contain no owl:sameAs between distinct nodes,
# so no alarm's pathway can leak into another's.

PREFIX mda: <https://w3id.org/mda/ontology#>

SELECT ?organ (GROUP_CONCAT(DISTINCT ?label; separator=" | ") AS ?alarms)
       (COUNT(DISTINCT ?a) AS ?matchCount)
       (COUNT(DISTINCT ?rep) AS ?distinctPathways) WHERE {
  # 1. Each alarm's sensing-pathway class, on ASSERTED types (CQ2's edge-set
  #    identity, verbatim): ?rep = smallest IRI among alarms with an equal set.
  {
    SELECT ?a (MIN(STR(?b)) AS ?rep) WHERE {
      {
        SELECT ?a ?b (COUNT(DISTINCT ?edge) AS ?shared) WHERE {
          { SELECT DISTINCT ?a ?edge WHERE { GRAPH <https://w3id.org/mda/graph/asserted> {
                        ?a a mda:AlarmType ; mda:hasMessage/mda:triggeredBy/mda:hasFunctionalUnit ?fu .
                        ?fu mda:hasSensor ?anySensor .
                        ?fu (mda:hasSensor|mda:sensorProducesSignal|mda:analyzedBy|mda:producesSignal|mda:producesMetric)* ?x .
                        ?x ?p ?y . FILTER(?p IN (mda:hasSensor, mda:sensorProducesSignal, mda:analyzedBy, mda:producesSignal, mda:producesMetric))
                        ?x a ?tx . ?y a ?ty .
                        BIND(CONCAT(STR(?tx), " ", STR(?p), " ", STR(?ty)) AS ?edge) } } }
          { SELECT DISTINCT ?b ?edge WHERE { GRAPH <https://w3id.org/mda/graph/asserted> {
                        ?b a mda:AlarmType ; mda:hasMessage/mda:triggeredBy/mda:hasFunctionalUnit ?fu .
                        ?fu mda:hasSensor ?anySensor .
                        ?fu (mda:hasSensor|mda:sensorProducesSignal|mda:analyzedBy|mda:producesSignal|mda:producesMetric)* ?x .
                        ?x ?p ?y . FILTER(?p IN (mda:hasSensor, mda:sensorProducesSignal, mda:analyzedBy, mda:producesSignal, mda:producesMetric))
                        ?x a ?tx . ?y a ?ty .
                        BIND(CONCAT(STR(?tx), " ", STR(?p), " ", STR(?ty)) AS ?edge) } } }
        } GROUP BY ?a ?b
      }
      { SELECT ?a (COUNT(DISTINCT ?edge) AS ?sizeA) WHERE { { SELECT DISTINCT ?a ?edge WHERE { GRAPH <https://w3id.org/mda/graph/asserted> {
                        ?a a mda:AlarmType ; mda:hasMessage/mda:triggeredBy/mda:hasFunctionalUnit ?fu .
                        ?fu mda:hasSensor ?anySensor .
                        ?fu (mda:hasSensor|mda:sensorProducesSignal|mda:analyzedBy|mda:producesSignal|mda:producesMetric)* ?x .
                        ?x ?p ?y . FILTER(?p IN (mda:hasSensor, mda:sensorProducesSignal, mda:analyzedBy, mda:producesSignal, mda:producesMetric))
                        ?x a ?tx . ?y a ?ty .
                        BIND(CONCAT(STR(?tx), " ", STR(?p), " ", STR(?ty)) AS ?edge) } } } } GROUP BY ?a }
      { SELECT ?b (COUNT(DISTINCT ?edge) AS ?sizeB) WHERE { { SELECT DISTINCT ?b ?edge WHERE { GRAPH <https://w3id.org/mda/graph/asserted> {
                        ?b a mda:AlarmType ; mda:hasMessage/mda:triggeredBy/mda:hasFunctionalUnit ?fu .
                        ?fu mda:hasSensor ?anySensor .
                        ?fu (mda:hasSensor|mda:sensorProducesSignal|mda:analyzedBy|mda:producesSignal|mda:producesMetric)* ?x .
                        ?x ?p ?y . FILTER(?p IN (mda:hasSensor, mda:sensorProducesSignal, mda:analyzedBy, mda:producesSignal, mda:producesMetric))
                        ?x a ?tx . ?y a ?ty .
                        BIND(CONCAT(STR(?tx), " ", STR(?p), " ", STR(?ty)) AS ?edge) } } } } GROUP BY ?b }
      FILTER(?shared = ?sizeA && ?shared = ?sizeB)
    } GROUP BY ?a
  }
  # 2. The organ, through the alarm's OWN metric, on the REASONED graph.
  ?a mda:hasLabel ?label ;
     mda:hasMessage/mda:triggeredBy/mda:hasFunctionalUnit/mda:hasSensor/mda:sensorProducesSignal/(mda:analyzedBy/(mda:producesSignal|mda:producesMetric))*/mda:analyzedBy/mda:producesMetric ?metricNode .
  FILTER NOT EXISTS { ?metricNode mda:analyzedBy ?consumer }
  # 3. Only a defined measurement counts: the own metric has a metric type
  #    of its own in the ASSERTED graph (not merely an approximates edge on
  #    an untyped node, see the header).
  GRAPH <https://w3id.org/mda/graph/asserted> {
    ?metricNode a ?metricType .
    FILTER(STRSTARTS(STR(?metricType), "https://w3id.org/mda/vocab/metric/"))
  }
  ?metricNode mda:approximates/mda:isPropertyOf/mda:presentIn ?organ .
}
GROUP BY ?organ
HAVING (COUNT(DISTINCT ?rep) > 1)
ORDER BY DESC(?distinctPathways) DESC(?matchCount) ?organ
