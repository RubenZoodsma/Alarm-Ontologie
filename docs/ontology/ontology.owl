<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/mda/ontology#"
     xml:base="https://w3id.org/mda/ontology#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ontology="https://w3id.org/mda/ontology#">
    <owl:Ontology rdf:about="https://w3id.org/mda/ontology#">
        <dc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dc:title xml:lang="en">MEdical Device Alarm Ontology</dc:title>
        <terms:abstract xml:lang="en">
        The Medical Device Alarm (MDA) Ontology provides a formal representation
        of the technical and clinical knowledge conveyed by medical device alarms.
        It models alarms in relation to measurements, devices, sensors,
        physiological variables, interpretations, and associated clinical or
        technical concerns, enabling alarm information to be represented in a
        machine-interpretable form.
        </terms:abstract>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-08</terms:created>
        <terms:creator>Ruben Zoodsma</terms:creator>
        <terms:description xml:lang="en">
        The MDA Ontology formally represents the concepts and relationships
        involved in medical device alarm generation and interpretation, making
        the implicit technical and clinical knowledge conveyed by alarms explicit
        and machine-interpretable.
        </terms:description>
        <vann:preferredNamespacePrefix>mda</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/mda/</vann:preferredNamespaceUri>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/license"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- https://w3id.org/mda/instantiatesClass -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/instantiatesClass">
        <terms:identifier>instantiatesClass</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een SKOS-conceptschema aan de ontologieklasse die zijn concepten specialiseren: een concept uit dit schema wordt gebruikt als het rdf:type van een instantie van die klasse.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a SKOS concept scheme to the ontology class its concepts specialise: a concept from this scheme is used as the rdf:type of an instance of that class.</rdfs:comment>
        <rdfs:label xml:lang="en">instantiates class</rdfs:label>
        <rdfs:label xml:lang="nl">instantieert klasse</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/nodeKind -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/nodeKind">
        <terms:identifier>nodeKind</terms:identifier>
        <rdfs:comment xml:lang="nl">Classificeert hoe instanties van een klasse in de gegenereerde graaf worden gerealiseerd: mda:Individuated, mda:Referential of mda:Stateful.</rdfs:comment>
        <rdfs:comment xml:lang="en">Classifies how instances of a class are realised in the generated graph: mda:Individuated, mda:Referential, or mda:Stateful.</rdfs:comment>
        <rdfs:label xml:lang="nl">knooppuntsoort</rdfs:label>
        <rdfs:label xml:lang="en">node kind</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/persistsPostAlarm -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/persistsPostAlarm">
        <terms:identifier>persistsPostAlarm</terms:identifier>
        <rdfs:comment xml:lang="nl">Markeert een objecteigenschap waarvan de afgeleide feiten over een technisch knooppunt blijven bestaan gedurende het PostAlarmValidScheme-venster nadat het alarm dat ze afleidde is beëindigd.</rdfs:comment>
        <rdfs:comment xml:lang="en">Marks an object property whose entailed facts about a technical node persist for the PostAlarmValidScheme window after the alarm that entailed them ends, the same way mda:hasOperationState already did — see 4_OPERATIONAL/op_knowledge.py&apos;s inferred_states.</rdfs:comment>
        <rdfs:label xml:lang="nl">blijft bestaan na alarm</rdfs:label>
        <rdfs:label xml:lang="en">persists post alarm</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/postAlarmValidityDuration -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/postAlarmValidityDuration">
        <terms:identifier>postAlarmValidityDuration</terms:identifier>
        <rdfs:comment xml:lang="en">Duration after alarm end for which assertions from this scheme remain valid. Absence of this annotation on a scheme implies alarm-duration only (PT0S).</rdfs:comment>
        <rdfs:comment xml:lang="nl">Duur na het alarm-einde gedurende welke beweringen geldig blijven. Afwezigheid impliceert alleen geldig tijdens alarm (PT0S).</rdfs:comment>
        <rdfs:label xml:lang="nl">post-alarm geldigheidsduur</rdfs:label>
        <rdfs:label xml:lang="en">post-alarm validity duration</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/refinesParticularIdentity -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/refinesParticularIdentity">
        <terms:identifier>refinesParticularIdentity</terms:identifier>
        <rdfs:comment xml:lang="nl">Markeert een blad-eigenschap waarvan de waarde één gemunt deeltje onderscheidt van een ander van hetzelfde type onder dezelfde eigenaar in de werkelijke wereld — verwerkt in de IRI van het deeltje bij grondingstijd, niet in een vocabulaireconcept.</rdfs:comment>
        <rdfs:comment xml:lang="en">Marks a leaf property whose value distinguishes one minted particular from another of the same type under the same real-world owner — folded into the particular&apos;s IRI at grounding time, not into a vocabulary concept.</rdfs:comment>
        <rdfs:label xml:lang="en">refines particular identity</rdfs:label>
        <rdfs:label xml:lang="nl">verfijnt particuliere identiteit</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/refinesUniversalIdentity -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/refinesUniversalIdentity">
        <terms:identifier>refinesUniversalIdentity</terms:identifier>
        <rdfs:comment xml:lang="nl">Markeert een blad-eigenschap waarvan de waarde voorcoördineert tot een gedeeld universeel concept op vocabulaireniveau, in plaats van de per-alarm/per-eigenaar toestand te beschrijven. De waarde benoemt een soort, herbruikbaar over eigenaren heen — geen plaatsing.</rdfs:comment>
        <rdfs:comment xml:lang="en">Marks a leaf property whose value pre-coordinates into a shared universal concept at the vocabulary layer, rather than describing per-alarm/per-owner state. The value names a kind, reusable across owners — not a placement.</rdfs:comment>
        <rdfs:label xml:lang="en">refines universal identity</rdfs:label>
        <rdfs:label xml:lang="nl">verfijnt universele identiteit</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/situational -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/situational">
        <terms:identifier>situational</terms:identifier>
        <rdfs:comment xml:lang="nl">Markeert een objecteigenschap waarvan de afgeleide beweringen behoren tot een situationele export per alarm, in tegenstelling tot achtergrond-/taxonomische structuur die een reasoner raadpleegt maar die zelf nooit wordt geëxporteerd.</rdfs:comment>
        <rdfs:comment xml:lang="en">Marks an object property whose entailed assertions belong in a per-alarm situational export, as opposed to background/taxonomic structure (e.g. rdfs:subClassOf) that a reasoner consults but that is never itself exported.</rdfs:comment>
        <rdfs:label xml:lang="en">situational</rdfs:label>
        <rdfs:label xml:lang="nl">situationeel</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mda/valuesFromScheme -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mda/valuesFromScheme">
        <terms:identifier>valuesFromScheme</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een objecteigenschap aan het SKOS-conceptschema waaruit zijn waarden afkomstig zijn.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an object property to the SKOS concept scheme from which its values are drawn.</rdfs:comment>
        <rdfs:label xml:lang="en">values from scheme</rdfs:label>
        <rdfs:label xml:lang="nl">waarden uit schema</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/mda/administers -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/administers">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Device"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/TherapeuticModality"/>
        <terms:identifier>administers</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een apparaat aan de therapeutische modaliteit die het toedient.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a device to the therapeutic modality it administers.</rdfs:comment>
        <rdfs:label xml:lang="en">administers</rdfs:label>
        <rdfs:label xml:lang="nl">toegediend</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/analyzedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/analyzedBy">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Signal"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/SignalAnalysis"/>
        <terms:identifier>analyzedBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een signaal aan de signaalanalysestap die het verbruikt. De enige weg naar mda:SignalAnalysis — bewust niet ook rechtstreeks bereikbaar vanaf mda:FunctionalUnit (er bestaat geen performsAnalysis-achtige kortere weg), zodat er precies één pad naar een analysestap bestaat, altijd via het specifieke signaal (de specifieke signalen) dat het daadwerkelijk verbruikt. Functioneel niet: hetzelfde signaal kan meer dan één analysestap voeden.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a signal to the signal-analysis step that consumes it. The only edge reaching mda:SignalAnalysis — deliberately not also reachable directly from mda:FunctionalUnit (no performsAnalysis-style shortcut exists), so there is exactly one path to an analysis step, always through the specific signal(s) it actually consumes. A second, shorter path would let ontology_tree.py&apos;s shortest-path class-tree derivation silently prefer it over the precise one (the same failure mode mda:administers was introduced to avoid for mda:TherapeuticModality — see the Technical axioms note in inference.ttl). Not functional: the same signal can feed more than one analysis step (e.g. ECG lead II feeds both a heart-rate computation and an aVF derivation).</rdfs:comment>
        <rdfs:label xml:lang="en">analyzed by</rdfs:label>
        <rdfs:label xml:lang="nl">geanalyseerd door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/approximates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/approximates">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Metric"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/PhysiologicalProperty"/>
        <terms:identifier>approximates</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een metriek aan de fysiologische eigenschap die het benadert.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a metric to the physiological property it approximates.</rdfs:comment>
        <rdfs:label xml:lang="en">approximates</rdfs:label>
        <rdfs:label xml:lang="nl">benadert</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/concernsPatient -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/concernsPatient">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/AlarmMessage"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Patient"/>
        <terms:identifier>concernsPatient</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een alarmbericht aan de patiënt die het betreft — het gedeelde, persistente samenvoegankerpunt. Bewust een doodlopend pad: leidt niet langer via mda:isMonitoredBy naar mda:Device. Functioneel: één bericht betreft precies één patiënt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an alarm message to the patient it concerns — the shared, persistent merge anchor. Deliberately a dead end: it no longer continues on to mda:Device via mda:isMonitoredBy (see mda:triggeredBy&apos;s comment for why). Functional: one message concerns exactly one patient — it is minted fresh per alarm precisely so it never needs to concern more than one.</rdfs:comment>
        <rdfs:label xml:lang="nl">betreft patiënt</rdfs:label>
        <rdfs:label xml:lang="en">concerns patient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasAnatomicalPosition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasAnatomicalPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/AnatomicalPosition"/>
        <terms:identifier>hasAnatomicalPosition</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een sensor aan zijn anatomische positie op het lichaam. Functioneel: een fysieke sensor bevindt zich op een gegeven moment op precies één positie.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to its anatomical position on the body. Functional: a physical sensor occupies exactly one position at a time.</rdfs:comment>
        <rdfs:label xml:lang="en">has anatomical position</rdfs:label>
        <rdfs:label xml:lang="nl">heeft anatomische positie</rdfs:label>
        <refinesParticularIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesParticularIdentity>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasCategory">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasCategory</terms:identifier>
        <rdfs:comment xml:lang="nl">De categorie van het alarm (beschrijvend, naast label en prioriteit).</rdfs:comment>
        <rdfs:comment xml:lang="en">The category of the alarm (a descriptive, alongside label and priority).</rdfs:comment>
        <rdfs:label xml:lang="en">has category</rdfs:label>
        <rdfs:label xml:lang="nl">heeft categorie</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/alarm-category/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasComponent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Device"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Component"/>
        <terms:identifier>hasComponent</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een apparaat aan zijn onderdelen, al dan niet sensorisch (bijv. een aansluitpoort, voedingseenheid, verwarmingselement of functionele eenheid). Invers-functioneel: een onderdeel behoort tot hoogstens één apparaat — er is geen aparte isComponentOf-eigenschap; bevraag alleen in deze richting.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a device to its components, sensing or not (e.g. a connection port, power unit, heating element, or functional unit). Inverse-functional: a component belongs to at most one device — no separate isComponentOf property is declared; query in this direction only.</rdfs:comment>
        <rdfs:label xml:lang="en">has component</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderdeel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasComponentOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasComponentOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasComponentOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een niet-sensorisch onderdeel, bijv. Disconnected of Warning. Een subeigenschap van hasOperationState met een enkel benoemd domein, zodat CSV-gestuurde readout het ondubbelzinnig kan koppelen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a non-sensing component, e.g. Disconnected or Warning. A sub-property of hasOperationState with a single named domain, so CSV-driven readout can attach it unambiguously.</rdfs:comment>
        <rdfs:label xml:lang="en">has component operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderdeeloperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasDeviceOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasDeviceOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasDeviceOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een apparaat zelf, bijv. Disconnected. Een subeigenschap van hasOperationState met een enkel benoemd domein, zodat CSV-gestuurde readout het ondubbelzinnig kan koppelen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a device itself, e.g. Disconnected. A sub-property of hasOperationState with a single named domain, so CSV-driven readout can attach it unambiguously.</rdfs:comment>
        <rdfs:label xml:lang="en">has device operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft apparaatoperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasDeviceType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasDeviceType">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasDeviceType</terms:identifier>
        <rdfs:comment xml:lang="nl">Het specifieke type of de modelaanduiding van het apparaat (bijv. ServoU).</rdfs:comment>
        <rdfs:comment xml:lang="en">The specific type or model designation of the device (e.g. ServoU).</rdfs:comment>
        <rdfs:label xml:lang="en">has device type</rdfs:label>
        <rdfs:label xml:lang="nl">heeft apparaattype</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/device-type/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasFunctionalUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasFunctionalUnit">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/hasComponent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Device"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/FunctionalUnit"/>
        <terms:identifier>hasFunctionalUnit</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een apparaat aan een functionele eenheid die het bevat (bijv. een ECG-module, een SpO2-module) — een subeigenschap van hasComponent, aangezien elke functionele eenheid een onderdeel is. Invers-functioneel: een functionele eenheid behoort tot hoogstens één apparaat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a device to a functional unit it houses (e.g. an ECG module, an SpO2 module) — a sub-property of hasComponent, since every functional unit is a component. Inverse-functional: a functional unit belongs to at most one device.</rdfs:comment>
        <rdfs:label xml:lang="en">has functional unit</rdfs:label>
        <rdfs:label xml:lang="nl">heeft functionele eenheid</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasLabelConcept -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasLabelConcept">
        <rdfs:domain rdf:resource="https://w3id.org/mda/AlarmType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasLabelConcept</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een alarmtype aan zijn gecontroleerde-vocabulaireconcept in het schema van mda:AlarmLabel — één concept per onderscheidend labelstring, gedeeld door elk archetype dat dat label gebruikt, ongeacht prioriteit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an alarm type to its controlled-vocabulary concept in mda:AlarmLabel&apos;s scheme — one concept per distinct label string encountered, shared across every archetype that uses that label regardless of priority (2_READOUT/vocab_readout.py&apos;s label_concept_iri keys on the label alone, not the archetype). The companion of mda:hasLabel, not a replacement for it.</rdfs:comment>
        <rdfs:label xml:lang="en">has label concept</rdfs:label>
        <rdfs:label xml:lang="nl">heeft labelconcept</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/alarm-label/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasLaterality -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasLaterality">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Laterality"/>
        <terms:identifier>hasLaterality</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een sensor aan zijn lateraliteit (links, rechts, bilateraal). Functioneel: een fysieke sensor heeft op een gegeven moment precies één lateraliteit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to its laterality (left, right, bilateral). Functional: a physical sensor has exactly one laterality at a time.</rdfs:comment>
        <rdfs:label xml:lang="en">has laterality</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lateraliteit</rdfs:label>
        <refinesParticularIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesParticularIdentity>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasManufacturer</terms:identifier>
        <rdfs:comment xml:lang="nl">De fabrikant of productlijn van het apparaat.</rdfs:comment>
        <rdfs:comment xml:lang="en">The manufacturer or product line of the device.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fabrikant</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/manufacturer/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasMessage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasMessage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/AlarmMessage"/>
        <terms:identifier>hasMessage</terms:identifier>
        <rdfs:comment xml:lang="nl">Het bericht van het alarm: een per-alarm mda:AlarmMessage-knooppunt met de onafhankelijke facetten van de gebeurtenis — mda:concernsPatient en mda:triggeredBy — als nevengeschikte eigenschappen, geen van beide via de ander bereikt. Functioneel en invers-functioneel: één alarm heeft precies één bericht en één bericht hoort bij precies één alarm.</rdfs:comment>
        <rdfs:comment xml:lang="en">The alarm&apos;s message: a per-alarm mda:AlarmMessage node carrying the occurrence&apos;s independent facets — mda:concernsPatient (who this alarm is about) and mda:triggeredBy (what caused it) — as siblings, neither reached through the other (see mda:triggeredBy&apos;s comment for why they used to be chained and no longer are). Distinct per alarm so many alarms can reference the same shared patient/device and merge there. Functional and inverse-functional: one alarm has exactly one message and one message belongs to exactly one alarm — alarm_iri/message_iri are minted from the same (device_id, start) key in 4_OPERATIONAL/op_knowledge.py precisely to keep this a bijection.</rdfs:comment>
        <rdfs:label xml:lang="en">has message</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bericht</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasOperationState">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/Component"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/Device"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/Sensor"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/Signal"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/TherapeuticModality"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/hasFunctionalUnit"/>
            <rdf:Description rdf:about="https://w3id.org/mda/hasOperationState"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/hasSensor"/>
            <rdf:Description rdf:about="https://w3id.org/mda/hasOperationState"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/producesSignal"/>
            <rdf:Description rdf:about="https://w3id.org/mda/hasOperationState"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/mda/administers"/>
            </rdf:Description>
            <rdf:Description rdf:about="https://w3id.org/mda/hasOperationState"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een apparaat, sensor, signaal, onderdeel, of de therapeutische modaliteit die een apparaat toedient (dit laatste afgeleid van de status van het toedienende apparaat, niet direct toegekend).</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a device, sensor, signal, component, or the therapeutic modality a device administers (the latter inferred from the administering device&apos;s own state, not asserted directly).</rdfs:comment>
        <rdfs:label xml:lang="en">has operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft operatiestatus</rdfs:label>
        <persistsPostAlarm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</persistsPostAlarm>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasPhase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasPhase">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasPhase</terms:identifier>
        <rdfs:comment xml:lang="nl">De fase van de metriek waarop de alarmconditie van toepassing is (bijv. gemiddeld, systolisch, diastolisch, eind-expiratoir).</rdfs:comment>
        <rdfs:comment xml:lang="en">The phase of the metric to which the alarm condition applies (e.g. mean, systolic, diastolic, end-expiratory).</rdfs:comment>
        <rdfs:label xml:lang="en">has phase</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fase</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/metric-phase/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasPriority -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasPriority">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasPriority</terms:identifier>
        <rdfs:comment xml:lang="nl">Het prioriteitsniveau van een alarm of alarmbericht.</rdfs:comment>
        <rdfs:comment xml:lang="en">The priority level of an alarm or alarm message.</rdfs:comment>
        <rdfs:label xml:lang="en">has priority</rdfs:label>
        <rdfs:label xml:lang="nl">heeft prioriteit</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/alarm-priority/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasQualityState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasQualityState">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Signal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasQualityState</terms:identifier>
        <rdfs:comment xml:lang="nl">De kwaliteitsstatus van een signaal, die de meetbetrouwbaarheid aangeeft.</rdfs:comment>
        <rdfs:comment xml:lang="en">The quality state of a signal, indicating measurement reliability.</rdfs:comment>
        <rdfs:label xml:lang="en">has quality state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kwaliteitsstatus</rdfs:label>
        <persistsPostAlarm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</persistsPostAlarm>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/quality-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasRate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasRate">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasRate</terms:identifier>
        <rdfs:comment xml:lang="nl">De snelheidsafwijking van de metriek die het alarm veroorzaakt (bijv. verhoogd, verlaagd, kritieke daling).</rdfs:comment>
        <rdfs:comment xml:lang="en">The rate deviation of the metric that raises the alarm (e.g. increased, decreased, critical decrease).</rdfs:comment>
        <rdfs:label xml:lang="en">has rate</rdfs:label>
        <rdfs:label xml:lang="nl">heeft snelheid</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/metric-rate/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasRhythm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasRhythm">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasRhythm</terms:identifier>
        <rdfs:comment xml:lang="nl">Het ritmepatroon van de metriek waarop de alarmconditie van toepassing is (bijv. onregelmatig).</rdfs:comment>
        <rdfs:comment xml:lang="en">The rhythm pattern of the metric to which the alarm condition applies (e.g. irregular).</rdfs:comment>
        <rdfs:label xml:lang="en">has rhythm</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ritme</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/rhythm/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasSensor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasSensor">
        <rdfs:domain rdf:resource="https://w3id.org/mda/FunctionalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Sensor"/>
        <terms:identifier>hasSensor</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een functionele eenheid aan de fysieke sensor(en) waarvan het afleest (bijv. een ECG-module aan elk van zijn 12 afleidingen). GEEN subeigenschap van hasComponent: het domein is FunctionalUnit, niet Device, en het domein van hasComponent ligt vast op Device. Een sensor behoort niet langer rechtstreeks tot een apparaat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a functional unit to the physical sensor(s) it reads from (e.g. an ECG module to each of its 12 leads). NOT a sub-property of hasComponent: its domain is FunctionalUnit, not Device, and hasComponent&apos;s domain is fixed to Device — declaring it a sub-property would wrongly entail every FunctionalUnit is itself a Device. A sensor no longer belongs directly to a device (see FunctionalUnit below for why: the sensor is the physical probe, the functional unit is what analyses what it picks up). Deliberately NOT owl:InverseFunctionalProperty, unlike most of this file&apos;s other IFP-marked relations: 2_READOUT/outcome/inference.ttl&apos;s FunctionalUnit recipe axioms assert hasSensor via an owl:hasValue restriction, so every alarm typed to the same FunctionalUnit concept (e.g. every FU_PneumoTachograph alarm) entails hasSensor to the SAME shared sensor concept, not a fresh individual per alarm the way 2_READOUT/vocab_readout.py&apos;s own per-row blank nodes do. Confirmed by an isolated reasoner test: with InverseFunctionalProperty declared, prp-ifp forces every one of those alarms&apos; FunctionalUnit individuals into owl:sameAs with each other — and would do the same across grounded, per-patient data in 4_OPERATIONAL if this property were ever reasoned over there, merging different patients&apos; equipment. mda:producesSignal carries the same latent risk if a future recipe axiom (e.g. the pending ECG one) ever reuses one signal concept across two different sensor concepts — watch for it there too.</rdfs:comment>
        <rdfs:label xml:lang="en">has sensor</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/hasSensorOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/hasSensorOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasSensorOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een sensor, bijv. Enabled, Disabled of Malfunction. Een subeigenschap van hasOperationState met een enkel benoemd domein, zodat CSV-gestuurde readout het ondubbelzinnig kan koppelen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a sensor, e.g. Enabled, Disabled, or Malfunction. A sub-property of hasOperationState with a single named domain, so CSV-driven readout can attach it unambiguously.</rdfs:comment>
        <rdfs:label xml:lang="en">has sensor operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sensoroperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/isMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/isMonitoredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Device"/>
        <terms:identifier>isMonitoredBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een patiënt aan het apparaat dat hen op dit moment bewaakt. Invers-functioneel: een apparaat bewaakt hoogstens één patiënt tegelijk.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a patient to the device currently monitoring them. No longer part of the blueprint&apos;s structural path to mda:Device (see mda:triggeredBy) — that routing asserted every alarm-raising device &apos;monitors&apos; the patient, which overclaims for a therapeutic one. What remains is this property&apos;s own, separate justification: inverse-functional, a device monitors at most one patient at a time — a physical monitor is not shared between two patients simultaneously, even though it may serve different patients at different times — so a reasoner can catch a double-booking directly (as an entailed owl:sameAs between two asserted-distinct patients) rather than relying on generator discipline, the same pattern as mda:hasSensor/mda:producesSignal below. Only meaningful if isMonitoredBy is asserted per-instant, not as a standing fact for a patient&apos;s whole encounter — see 4_OPERATIONAL/op_knowledge.py, the only place it is still asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">is monitored by</rdfs:label>
        <rdfs:label xml:lang="nl">wordt bewaakt door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/isOfType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/isOfType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/AlarmType"/>
        <terms:identifier>isOfType</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een concrete alarminstantie aan zijn archetypische alarmtype in de typecatalogus, waaruit standaard structurele kennis (apparaattype, sensortype, signaaltype) kan worden geërfd. Functioneel: één alarminstantie is van precies één archetype.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a concrete alarm instance to its archetypal alarm type in the type catalogue, from which default structural knowledge (device type, sensor type, signal type) can be inherited. Functional: one alarm occurrence is of exactly one archetype.</rdfs:comment>
        <rdfs:label xml:lang="en">is of type</rdfs:label>
        <rdfs:label xml:lang="nl">is van type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/isPropertyOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/isPropertyOf">
        <rdfs:domain rdf:resource="https://w3id.org/mda/PhysiologicalProperty"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/PhysiologicalProcess"/>
        <terms:identifier>isPropertyOf</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een fysiologische eigenschap aan het proces dat het karakteriseert.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a physiological property to the process it characterises.</rdfs:comment>
        <rdfs:label xml:lang="nl">is eigenschap van</rdfs:label>
        <rdfs:label xml:lang="en">is property of</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/organPartOfSystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/organPartOfSystem">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Organ"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/OrganSystem"/>
        <terms:identifier>organPartOfSystem</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een orgaan aan het orgaansysteem waartoe het behoort.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an organ to the organ system it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="nl">orgaan deel van systeem</rdfs:label>
        <rdfs:label xml:lang="en">organ part of system</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/presentIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/presentIn">
        <rdfs:domain rdf:resource="https://w3id.org/mda/PhysiologicalProcess"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Organ"/>
        <terms:identifier>presentIn</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een fysiologisch proces aan het orgaan waarin het plaatsvindt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a physiological process to the organ it occurs in.</rdfs:comment>
        <rdfs:label xml:lang="nl">aanwezig in</rdfs:label>
        <rdfs:label xml:lang="en">present in</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/producesMetric -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/producesMetric">
        <rdfs:domain rdf:resource="https://w3id.org/mda/SignalAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Metric"/>
        <terms:identifier>producesMetric</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een signaalanalysestap aan de metriek die het berekent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a signal-analysis step to the metric it computes.</rdfs:comment>
        <rdfs:label xml:lang="nl">produceert metriek</rdfs:label>
        <rdfs:label xml:lang="en">produces metric</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/producesSignal -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/producesSignal">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/Sensor"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/SignalAnalysis"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/mda/Signal"/>
        <terms:identifier>producesSignal</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een sensor OF een signaalanalysestap aan het signaal dat het produceert — het ruwe signaal van een sensor, of het afgeleide/tussenliggende signaal van een analysestap (bijv. versterkte afleiding aVF, gecombineerd uit andere afleidingen). Invers-functioneel: een signaal heeft hoogstens één producent, ongeacht het soort.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor OR a signal-analysis step to the signal it produces — a sensor&apos;s raw signal, or an analysis step&apos;s derived/intermediate signal (e.g. augmented lead aVF, combined from other leads). Inverse-functional: a signal has at most one producer, whichever kind produced it. Its domain is a union, so it cannot itself anchor 2_READOUT/vocab_readout.py&apos;s CSV/tree derivation (ontology_tree.py&apos;s derive_class_tree only follows a named rdfs:domain, the same limitation documented at mda:hasOperationState below) — mda:sensorProducesSignal is the single-domain sub-property that does. A signal-analysis step&apos;s own derived-signal output (the aVF case) is only ever hand-authored in inference.ttl, never CSV-driven, so it uses this general property directly and needs no sub-property of its own.</rdfs:comment>
        <rdfs:label xml:lang="nl">produceert signaal</rdfs:label>
        <rdfs:label xml:lang="en">produces signal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/sensorProducesSignal -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/sensorProducesSignal">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/producesSignal"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Signal"/>
        <terms:identifier>sensorProducesSignal</terms:identifier>
        <rdfs:comment xml:lang="nl">Het CSV/boom-gerichte geval van mda:producesSignal: het eigen ruwe signaal van een sensor. Een subeigenschap met één domein, zodat de door 2_READOUT/vocab_readout.py afgeleide boom Signal ondubbelzinnig onder Sensor kan hangen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The CSV/tree-facing case of mda:producesSignal: a sensor&apos;s own raw signal. A single-domain sub-property so 2_READOUT/vocab_readout.py&apos;s ontology-derived tree can attach Signal under Sensor unambiguously — see mda:producesSignal&apos;s comment. Every fact asserted through it still entails the general mda:producesSignal fact (and, transitively, mda:hasOperationState&apos;s propagation chain) via rdfs:subPropertyOf.</rdfs:comment>
        <rdfs:label xml:lang="nl">sensor produceert signaal</rdfs:label>
        <rdfs:label xml:lang="en">sensor produces signal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/targetsProcess -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/targetsProcess">
        <rdfs:domain rdf:resource="https://w3id.org/mda/TherapeuticModality"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/PhysiologicalProcess"/>
        <terms:identifier>targetsProcess</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een therapeutische modaliteit aan het fysiologische proces waarop het zich richt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a therapeutic modality to the physiological process it targets.</rdfs:comment>
        <rdfs:label xml:lang="nl">richt zich op proces</rdfs:label>
        <rdfs:label xml:lang="en">targets process</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/triggeredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/triggeredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/AlarmMessage"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/Device"/>
        <terms:identifier>triggeredBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een alarmbericht rechtstreeks aan het apparaat waarvan het de technische structuur impliceert — de enige weg van AlarmMessage naar de mda:Device-deelboom. Vervangt routering via mda:concernsPatient/mda:isMonitoredBy: die keten beweerde dat elk alarmerend apparaat de patiënt &apos;bewaakt&apos;, wat onjuist is voor een wezenlijk therapeutisch apparaat. mda:isMonitoredBy zelf is ONGEWIJZIGD en blijft gebruikt, maar uitsluitend voor de eigen operationele rechtvaardiging. Functioneel, niet invers-functioneel.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an alarm message directly to the device whose technical structure it implicates — the sole path from AlarmMessage into the mda:Device subtree (mda:hasFunctionalUnit, mda:hasSensor, ...). Replaces routing that reach through mda:concernsPatient/mda:isMonitoredBy: that chain asserted every alarm-raising device &apos;monitors&apos; the patient, which is false for a fundamentally therapeutic device (mda:MechanicalVentilator, mda:Dialysator, mda:ExtracorporealMembraneOxygenator, mda:Incubator/mda:Thermoregulator all administer a therapy — see mda:administers — rather than principally observe). mda:isMonitoredBy itself is UNCHANGED and still used, but only for its own actual justification: 4_OPERATIONAL/op_knowledge.py&apos;s per-instant double-booking check, asserted fresh at grounding time, never derived from or dependent on this blueprint-level structure. Functional, not inverse-functional: one message has exactly one triggering device, but one device triggers many messages over its lifetime — unlike mda:hasMessage&apos;s strict bijection.</rdfs:comment>
        <rdfs:label xml:lang="en">triggered by</rdfs:label>
        <rdfs:label xml:lang="nl">veroorzaakt door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/mda/hasDuration -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/hasDuration">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <terms:identifier>hasDuration</terms:identifier>
        <rdfs:comment xml:lang="nl">De duur van het alarm.</rdfs:comment>
        <rdfs:comment xml:lang="en">The duration of the alarm.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <rdfs:label xml:lang="nl">heeft duur</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/mda/hasEnd -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/hasEnd">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <terms:identifier>hasEnd</terms:identifier>
        <rdfs:comment xml:lang="nl">Het eindtijdstip van het alarm.</rdfs:comment>
        <rdfs:comment xml:lang="en">The end time of the alarm.</rdfs:comment>
        <rdfs:label xml:lang="en">has end</rdfs:label>
        <rdfs:label xml:lang="nl">heeft einde</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/mda/hasLabel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/hasLabel">
        <rdfs:domain rdf:resource="https://w3id.org/mda/AlarmType"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <terms:identifier>hasLabel</terms:identifier>
        <rdfs:comment xml:lang="nl">Het vrije-tekstlabel dat een alarmtype identificeert, exact zoals het in de brondata voorkomt — een literal, geen concept. mda:hasLabelConcept is de bijbehorende gecontroleerde-vocabulaire lezing van hetzelfde label; beide worden bewust bijgehouden. AlarmType is het enige domein; een Alarm-instantie bereikt zijn label via mda:isOfType.</rdfs:comment>
        <rdfs:comment xml:lang="en">The free-text label identifying an alarm type, exactly as it occurs in the source data (e.g. &apos;PHILIPSMONITOR - SpO2 geen pols&apos;) — a literal, not a concept: alarm labels routinely contain spaces and punctuation no SKOS notation can carry. mda:hasLabelConcept is the companion controlled-vocabulary reading of the same label — the two are deliberately BOTH kept, not alternatives: this ontology wants both the label as encountered and a stable, deduplicated vocabulary entry for it (the same label recurs across archetypes that differ only in priority). AlarmType is its only domain; a plain Alarm instance reaches its label via mda:isOfType.</rdfs:comment>
        <rdfs:label xml:lang="en">has label</rdfs:label>
        <rdfs:label xml:lang="nl">heeft label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/mda/hasStart -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/hasStart">
        <rdfs:domain rdf:resource="https://w3id.org/mda/Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <terms:identifier>hasStart</terms:identifier>
        <rdfs:comment xml:lang="nl">Het starttijdstip van het alarm.</rdfs:comment>
        <rdfs:comment xml:lang="en">The start time of the alarm.</rdfs:comment>
        <rdfs:label xml:lang="en">has start</rdfs:label>
        <rdfs:label xml:lang="nl">heeft start</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- https://w3id.org/mda/Alarm -->


    <owl:Class rdf:about="https://w3id.org/mda/Alarm">
        <terms:identifier>Alarm</terms:identifier>
        <rdfs:comment xml:lang="en">A notification or alert generated by a medical device.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een melding of waarschuwing gegenereerd door een medisch apparaat.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm</rdfs:label>
        <rdfs:label xml:lang="nl">Alarm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/AlarmMessage -->


    <owl:Class rdf:about="https://w3id.org/mda/AlarmMessage">
        <terms:identifier>AlarmMessage</terms:identifier>
        <rdfs:comment xml:lang="en">A per-alarm message node — the hub for this occurrence&apos;s independent facets: mda:concernsPatient (the shared, persistent patient — the merge anchor operational inference reasons across alarms over) and mda:triggeredBy (the device whose technical structure this alarm implicates), reached as siblings rather than one gatewaying the other.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een per-alarm berichtknooppunt — het knooppunt voor de onafhankelijke facetten van deze gebeurtenis: mda:concernsPatient en mda:triggeredBy, als nevengeschikte eigenschappen bereikt.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm Message</rdfs:label>
        <rdfs:label xml:lang="nl">Alarmbericht</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/AlarmType -->


    <owl:Class rdf:about="https://w3id.org/mda/AlarmType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/Alarm"/>
        <terms:identifier>AlarmType</terms:identifier>
        <rdfs:comment xml:lang="en">A generic, archetypal alarm definition independent of any specific device instance or patient encounter. Captures the default device, sensor, and signal structure associated with a class of alarm.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een generieke, archetypische alarmdefinitie, onafhankelijk van een specifieke apparaatinstantie of patiëntencounter. Legt de standaard apparaat-, sensor- en signaalstructuur vast die samenhangt met een klasse van alarmen.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm Type</rdfs:label>
        <rdfs:label xml:lang="nl">Alarmtype</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/AnatomicalPosition -->


    <owl:Class rdf:about="https://w3id.org/mda/AnatomicalPosition">
        <terms:identifier>AnatomicalPosition</terms:identifier>
        <rdfs:comment xml:lang="nl">De anatomische positie van een sensor op het lichaam.</rdfs:comment>
        <rdfs:comment xml:lang="en">The anatomical position of a sensor on the body.</rdfs:comment>
        <rdfs:label xml:lang="en">Anatomical Position</rdfs:label>
        <rdfs:label xml:lang="nl">Anatomische Positie</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Component -->


    <owl:Class rdf:about="https://w3id.org/mda/Component">
        <terms:identifier>Component</terms:identifier>
        <rdfs:comment xml:lang="en">A physical or functional part of a medical device (e.g. a connection port, power unit, or heating element). mda:Sensor is the specialisation that additionally produces a measurable signal — every sensor is a component, but not every component senses.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een fysiek of functioneel onderdeel van een medisch apparaat (bijv. een aansluitpoort, voedingseenheid of verwarmingselement). mda:Sensor is de specialisatie die daarnaast een meetbaar signaal produceert — elke sensor is een onderdeel, maar niet elk onderdeel meet.</rdfs:comment>
        <rdfs:label xml:lang="en">Component</rdfs:label>
        <rdfs:label xml:lang="nl">Onderdeel</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/CriticalComponent -->


    <owl:Class rdf:about="https://w3id.org/mda/CriticalComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/Component"/>
        <terms:identifier>CriticalComponent</terms:identifier>
        <rdfs:comment xml:lang="nl">De subklasse van mda:Component waarvan het loskoppelen betekent dat het apparaat zelf niet beschikbaar is (bijv. de datapoort, de stroomaansluiting) — in tegenstelling tot een randonderdeel waarvan het loskoppelen slechts een subsysteemwaarschuwing is (bijv. een matrasverwarming).</rdfs:comment>
        <rdfs:comment xml:lang="en">The subclass of mda:Component whose own disconnection means the device itself is unavailable (e.g. the data-link port, the power inlet) — as opposed to a peripheral component whose disconnection is only a subsystem-level warning (e.g. a mattress heater). This class exists so the propagation rule using it can be precise: unconditionally true for CriticalComponent, never assumed for mda:Component as a whole — see mda:hasOperationState&apos;s comment below on why mda:hasComponent was deliberately dropped from its propertyChainAxiom. The rule itself, and which concrete vocabulary-level component types (e.g. component:ConnectionUnit, component:PowerUnit) are tagged as members of this class, both live in 2_READOUT/outcome/inference.ttl&apos;s Component operational-state propagation section — the rule&apos;s hasValue target (a specific operation-state concept) is catalogue vocabulary, so it cannot be asserted here, but this class it&apos;s written over is a plain structural distinction with no vocabulary dependency, so it belongs in this TBox, not duplicated per component type down there.</rdfs:comment>
        <rdfs:label xml:lang="en">Critical component</rdfs:label>
        <rdfs:label xml:lang="nl">Kritiek onderdeel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Device -->


    <owl:Class rdf:about="https://w3id.org/mda/Device">
        <terms:identifier>Device</terms:identifier>
        <rdfs:comment xml:lang="en">A medical device that generates alarms.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een medisch apparaat dat alarmen genereert.</rdfs:comment>
        <rdfs:label xml:lang="nl">Apparaat</rdfs:label>
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/FunctionalUnit -->


    <owl:Class rdf:about="https://w3id.org/mda/FunctionalUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/Component"/>
        <owl:disjointWith rdf:resource="https://w3id.org/mda/Sensor"/>
        <terms:identifier>FunctionalUnit</terms:identifier>
        <rdfs:comment xml:lang="nl">De module van een apparaat die de berekeningslogica voor een bepaalde meetmogelijkheid huisvest (bijv. een ECG-module, een SpO2-module) — in de volksmond vaak &apos;de sensor&apos; genoemd, maar hier onderscheiden van mda:Sensor, dat enkel de fysieke probe is. Een functionele eenheid leest van één of meer sensoren en zet, via één of meer mda:SignalAnalysis-stappen, hun signalen om in metrieken. Een specialisatie van mda:Component. Disjunct verklaard met mda:Sensor vanwege precies die volkstaal-verwarring.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module of a device that houses the computation logic for a particular measurement capability (e.g. an ECG module, an SpO2 module) — often called &apos;the sensor&apos; colloquially, but distinct here from mda:Sensor, which is only the physical probe. A functional unit reads from one or more sensors and, via one or more mda:SignalAnalysis steps, turns their signals into metrics. A specialisation of mda:Component. Declared disjoint with mda:Sensor precisely because of that colloquial conflation — the two are easy to confuse in exactly the way this class&apos;s own name tries to prevent, so a node accidentally typed as both is now an inconsistency a reasoner catches rather than a silent modelling error.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional unit</rdfs:label>
        <rdfs:label xml:lang="nl">Functionele eenheid</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Laterality -->


    <owl:Class rdf:about="https://w3id.org/mda/Laterality">
        <terms:identifier>Laterality</terms:identifier>
        <rdfs:comment xml:lang="nl">De lateraliteit (links, rechts, bilateraal) van een sensorpositie.</rdfs:comment>
        <rdfs:comment xml:lang="en">The laterality (left, right, bilateral) of a sensor position.</rdfs:comment>
        <rdfs:label xml:lang="nl">Lateraliteit</rdfs:label>
        <rdfs:label xml:lang="en">Laterality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Metric -->


    <owl:Class rdf:about="https://w3id.org/mda/Metric">
        <terms:identifier>Metric</terms:identifier>
        <rdfs:comment xml:lang="en">A measurable quantity, computed from one or more signals by a mda:SignalAnalysis step.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een meetbare grootheid, berekend uit één of meer signalen door een mda:SignalAnalysis-stap.</rdfs:comment>
        <rdfs:label xml:lang="en">Metric</rdfs:label>
        <rdfs:label xml:lang="nl">Metriek</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Stateful"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Organ -->


    <owl:Class rdf:about="https://w3id.org/mda/Organ">
        <terms:identifier>Organ</terms:identifier>
        <rdfs:comment xml:lang="en">A biological organ.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een biologisch orgaan.</rdfs:comment>
        <rdfs:label xml:lang="nl">Orgaan</rdfs:label>
        <rdfs:label xml:lang="en">Organ</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/OrganSystem -->


    <owl:Class rdf:about="https://w3id.org/mda/OrganSystem">
        <terms:identifier>OrganSystem</terms:identifier>
        <rdfs:comment xml:lang="en">A system of related organs in the body.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een systeem van gerelateerde organen in het lichaam.</rdfs:comment>
        <rdfs:label xml:lang="nl">Orgaansysteem</rdfs:label>
        <rdfs:label xml:lang="en">Organ System</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Patient -->


    <owl:Class rdf:about="https://w3id.org/mda/Patient">
        <terms:identifier>Patient</terms:identifier>
        <rdfs:comment xml:lang="en">A patient being monitored by medical devices.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een patiënt die wordt bewaakt door medische apparaten.</rdfs:comment>
        <rdfs:label xml:lang="en">Patient</rdfs:label>
        <rdfs:label xml:lang="nl">Patiënt</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/PhysiologicalProcess -->


    <owl:Class rdf:about="https://w3id.org/mda/PhysiologicalProcess">
        <terms:identifier>PhysiologicalProcess</terms:identifier>
        <rdfs:comment xml:lang="en">A biological or physiological process occurring in the body.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een biologisch of fysiologisch proces dat in het lichaam plaatsvindt.</rdfs:comment>
        <rdfs:label xml:lang="nl">Fysiologisch Proces</rdfs:label>
        <rdfs:label xml:lang="en">Physiological Process</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/PhysiologicalProperty -->


    <owl:Class rdf:about="https://w3id.org/mda/PhysiologicalProperty">
        <terms:identifier>PhysiologicalProperty</terms:identifier>
        <rdfs:comment xml:lang="en">A measurable property of a physiological process.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een meetbare eigenschap van een fysiologisch proces.</rdfs:comment>
        <rdfs:label xml:lang="nl">Fysiologische Eigenschap</rdfs:label>
        <rdfs:label xml:lang="en">Physiological Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/PostAlarmValidScheme -->


    <owl:Class rdf:about="https://w3id.org/mda/PostAlarmValidScheme">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:identifier>PostAlarmValidScheme</terms:identifier>
        <rdfs:comment xml:lang="en">A SKOS concept scheme whose concepts remain valid for a fixed duration after an alarm ends.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een SKOS-conceptschema waarvan de concepten geldig blijven gedurende een vaste duur nadat een alarm is geëindigd.</rdfs:comment>
        <rdfs:label xml:lang="nl">Post-alarm geldig schema</rdfs:label>
        <rdfs:label xml:lang="en">Post-alarm valid scheme</rdfs:label>
        <postAlarmValidityDuration rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT60S</postAlarmValidityDuration>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Sensor -->


    <owl:Class rdf:about="https://w3id.org/mda/Sensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/Component"/>
        <terms:identifier>Sensor</terms:identifier>
        <rdfs:comment xml:lang="nl">Het fysieke object dat geplaatst wordt om een signaal te genereren — bijv. een pulse-oximetrieklip, een ECG-afleiding, een temperatuurprobe. Het meet of berekent zelf niets: het produceert enkel een ruw signaal (mda:producesSignal). Dat signaal omzetten in een metriek is de taak van mda:FunctionalUnit, via mda:SignalAnalysis. Een specialisatie van mda:Component.</rdfs:comment>
        <rdfs:comment xml:lang="en">The physical object placed to generate a signal — e.g. a pulse-oximetry clip, an ECG lead, a temperature probe. It does not itself measure or compute anything: it only produces a raw signal (mda:producesSignal). Turning that signal into a metric is mda:FunctionalUnit&apos;s job, via mda:SignalAnalysis. A specialisation of mda:Component. Declared disjoint with mda:FunctionalUnit (see its own comment) — asserted there, applies symmetrically.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <rdfs:label xml:lang="nl">Sensor</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/Signal -->


    <owl:Class rdf:about="https://w3id.org/mda/Signal">
        <terms:identifier>Signal</terms:identifier>
        <rdfs:comment xml:lang="en">A signal — either raw, produced by a sensor, or derived/intermediate, produced by a mda:SignalAnalysis step from other signals (e.g. augmented lead aVF, combined from ECG leads I and II). No structural distinction between the two: a later analysis step consuming a signal doesn&apos;t need to know whether it came from a sensor or from an earlier analysis.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een signaal — ofwel ruw, geproduceerd door een sensor, ofwel afgeleid/tussenliggend, geproduceerd door een mda:SignalAnalysis-stap uit andere signalen (bijv. versterkte afleiding aVF, gecombineerd uit ECG-afleidingen I en II). Geen structureel onderscheid tussen beide: een latere analysestap die een signaal verbruikt hoeft niet te weten of het van een sensor komt of van een eerdere analyse.</rdfs:comment>
        <rdfs:label xml:lang="nl">Signaal</rdfs:label>
        <rdfs:label xml:lang="en">Signal</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/SignalAnalysis -->


    <owl:Class rdf:about="https://w3id.org/mda/SignalAnalysis">
        <terms:identifier>SignalAnalysis</terms:identifier>
        <rdfs:comment xml:lang="nl">Eén berekeningsstap van een functionele eenheid: verbruikt één of meer signalen (bereikt via de inverse van mda:analyzedBy) en produceert ofwel een metriek (mda:producesMetric) ofwel een verder afgeleid signaal (mda:producesSignal) dat een latere stap op zijn beurt kan verbruiken. Zelf geen mda:Component — het is de berekening die een functionele eenheid uitvoert, geen fysiek onderdeel.</rdfs:comment>
        <rdfs:comment xml:lang="en">One computation step of a functional unit: consumes one or more signals (reached via the inverse of mda:analyzedBy) and produces either a metric (mda:producesMetric) or a further, derived signal (mda:producesSignal) that a later step can itself consume. Not itself a mda:Component — it&apos;s the computation a functional unit performs, not a physical part.</rdfs:comment>
        <rdfs:label xml:lang="nl">Signaalanalyse</rdfs:label>
        <rdfs:label xml:lang="en">Signal analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/TherapeuticModality -->


    <owl:Class rdf:about="https://w3id.org/mda/TherapeuticModality">
        <terms:identifier>TherapeuticModality</terms:identifier>
        <rdfs:comment xml:lang="en">A therapeutic intervention or treatment modality.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een therapeutische interventie of behandelingsmodaliteit.</rdfs:comment>
        <rdfs:label xml:lang="en">Therapeutic Modality</rdfs:label>
        <rdfs:label xml:lang="nl">Therapeutische Modaliteit</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/mda/Individuated -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mda/Individuated">
        <rdfs:label xml:lang="en">individuated</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mda/Referential -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mda/Referential">
        <rdfs:label xml:lang="en">referential</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mda/Stateful -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mda/Stateful">
        <rdfs:label xml:lang="en">stateful</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
