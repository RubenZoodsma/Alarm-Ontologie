    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- https://w3id.org/mda/ontology#administers -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#administers">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#TherapeuticModality"/>
        <terms:identifier>administers</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een apparaat aan de therapeutische modaliteit die het toedient.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a device to the therapeutic modality it administers.</rdfs:comment>
        <rdfs:label xml:lang="en">administers</rdfs:label>
        <rdfs:label xml:lang="nl">toegediend</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#analyzedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#analyzedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Metric"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Signal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#SignalAnalysis"/>
        <terms:identifier>analyzedBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een signaal, of een metriek, aan de analysestap die het verbruikt. Een metriek als invoer maakt de stap een afleiding (bijv. slagvolume uit hartminuutvolume en hartfrequentie). De enige weg naar mda:SignalAnalysis — bewust niet ook rechtstreeks bereikbaar vanaf mda:FunctionalUnit (er bestaat geen performsAnalysis-achtige kortere weg), zodat er precies één pad naar een analysestap bestaat, altijd via het specifieke signaal (de specifieke signalen) dat het daadwerkelijk verbruikt. Functioneel niet: hetzelfde signaal kan meer dan één analysestap voeden.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a signal, or a metric, to the analysis step that consumes it. A metric input makes the step a derivation: stroke volume computed from cardiac output and heart rate, an indexed value from its unindexed value and body surface area (see the Derived metrics section in inference.ttl). The union domain does not let a reasoner type anything as a Signal or a Metric from this edge, which matters because inference.ttl asserts it on punned metric concepts. ontology_tree.py&apos;s derive_class_tree ignores the Metric member: mda:SignalAnalysis is already reached through mda:Signal, at a shallower depth, so the archetype tree is unchanged. The only edge reaching mda:SignalAnalysis — deliberately not also reachable directly from mda:FunctionalUnit (no performsAnalysis-style shortcut exists), so there is exactly one path to an analysis step, always through the specific signal(s) it actually consumes. A second, shorter path would let ontology_tree.py&apos;s shortest-path class-tree derivation silently prefer it over the precise one (the same failure mode mda:administers was introduced to avoid for mda:TherapeuticModality — see the Technical axioms note in inference.ttl). Not functional: the same signal can feed more than one analysis step (e.g. the LL raw signal feeds the derivations of leads II, III and aVF).</rdfs:comment>
        <rdfs:label xml:lang="en">analyzed by</rdfs:label>
        <rdfs:label xml:lang="nl">geanalyseerd door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#approximates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#approximates">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProperty"/>
        <terms:identifier>approximates</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een metriek aan de fysiologische eigenschap die het benadert.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a metric to the physiological property it approximates.</rdfs:comment>
        <rdfs:label xml:lang="en">approximates</rdfs:label>
        <rdfs:label xml:lang="nl">benadert</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#concernsPatient -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#concernsPatient">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#AlarmMessage"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#ClinicalEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Patient"/>
        <terms:identifier>concernsPatient</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een alarmbericht, of een klinische gebeurtenis, aan de patiënt die het betreft — het gedeelde, persistente samenvoegankerpunt. Bewust een doodlopend pad: leidt niet via mda:isMonitoredBy naar mda:Device. Functioneel: één bericht of gebeurtenis betreft precies één patiënt. Bij een klinische gebeurtenis is dit wat de gebeurtenis aan één patiënt bindt; het bewijs (mda:evidencedBy) doet dat nooit op zichzelf.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an alarm message, or a clinical event, to the patient it concerns — the shared, persistent merge anchor. Deliberately a dead end: it does not continue on to mda:Device via mda:isMonitoredBy (see mda:triggeredBy&apos;s comment for why). Functional: one message or event concerns exactly one patient — both are minted fresh per occurrence precisely so they never need to concern more than one. On a clinical event this is what scopes the event to one patient; its evidence (mda:evidencedBy) never does that on its own.</rdfs:comment>
        <rdfs:label xml:lang="nl">betreft patiënt</rdfs:label>
        <rdfs:label xml:lang="en">concerns patient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#evidencedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#evidencedBy">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#ClinicalEvent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#ClinicalEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Device"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Metric"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#TherapeuticModality"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:identifier>evidencedBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een klinische gebeurtenis aan een knooppunt waarvan de toestand bewijs ervoor is — het controlespoor voor waarom de gebeurtenis wordt aangenomen, vastgelegd voor elk ondersteunend knooppunt, ook als er maar één is. De pijl loopt alleen van de gebeurtenis naar haar bewijs; niets verwijst terug. Bewijs is altijd een knooppunt dat is aangemaakt voor het alarm dat het rapporteerde (een metriek, een apparaat) of een andere klinische gebeurtenis, nooit een gedeeld vocabulaireconcept. Het bereik dekt de huidige criteria: een Metric (een gebeurtenis uit één alarm, zoals een hartstilstand), een TherapeuticModality (de gecompromitteerde beademingstherapie bij beademingsfalen) en een ClinicalEvent (een samengestelde gebeurtenis verwijst naar haar samenstellende gebeurtenissen). Device blijft in het bereik voor criteria die op de eigen toestand van een apparaat rusten; geen enkel criterium doet dat momenteel.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a clinical event to a node whose state is evidence for it — the audit trail for why the event is believed, asserted for every supporting node, even when there is only one. The arrow runs from the event to its evidence only; nothing points back from evidence to event. Evidence is always a node minted for the alarm that reported it (a metric, a device) or another clinical event, never a shared vocabulary concept: a shared concept is reached by every patient&apos;s alarms and would say nothing about this one. The range covers the current criteria: a Metric (a single-alarm event such as cardiac arrest), a TherapeuticModality (the compromised ventilation therapy in ventilation failure) and a ClinicalEvent (a combined event points at its constituent events). Device stays in the range for criteria that rest on a device&apos;s own state; none does at present.</rdfs:comment>
        <rdfs:label xml:lang="en">evidenced by</rdfs:label>
        <rdfs:label xml:lang="nl">onderbouwd door</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasAggregation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasAggregation">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasAggregation</terms:identifier>
        <rdfs:comment xml:lang="nl">Hoe de metriek over MEERDERE fysiologische cycli wordt samengesteld tot één gerapporteerd getal over een vast tijdvenster (bijv. minuut). Onderscheiden van mda:hasPhase, dat binnen één cyclus blijft — gemiddelde druk en teugvolume zijn grootheden van één cyclus en horen daar thuis, niet hier.</rdfs:comment>
        <rdfs:comment xml:lang="en">How the metric is composed across MANY physiological cycles into a single reported figure over a fixed window (e.g. minute). Distinct from mda:hasPhase, which stays within one cycle — mean pressure and tidal volume are single-cycle quantities and belong there, not here.</rdfs:comment>
        <rdfs:label xml:lang="en">has aggregation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aggregatie</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/metric-aggregation/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasAnatomicalPosition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasAnatomicalPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#AnatomicalPosition"/>
        <terms:identifier>hasAnatomicalPosition</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een sensor aan zijn anatomische positie op het lichaam. Functioneel: een fysieke sensor bevindt zich op een gegeven moment op precies één positie.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to its anatomical position on the body. Functional: a physical sensor occupies exactly one position at a time.</rdfs:comment>
        <rdfs:label xml:lang="en">has anatomical position</rdfs:label>
        <rdfs:label xml:lang="nl">heeft anatomische positie</rdfs:label>
        <refinesParticularIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesParticularIdentity>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasCategory">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasCategory</terms:identifier>
        <rdfs:comment xml:lang="nl">De categorie van het alarm (beschrijvend, naast label en prioriteit).</rdfs:comment>
        <rdfs:comment xml:lang="en">The category of the alarm (a descriptive, alongside label and priority).</rdfs:comment>
        <rdfs:label xml:lang="en">has category</rdfs:label>
        <rdfs:label xml:lang="nl">heeft categorie</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/alarm-category/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasComponent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Component"/>
        <terms:identifier>hasComponent</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een apparaat aan zijn onderdelen, al dan niet sensorisch (bijv. een aansluitpoort, voedingseenheid, verwarmingselement of functionele eenheid). Invers-functioneel: een onderdeel behoort tot hoogstens één apparaat — er is geen aparte isComponentOf-eigenschap; bevraag alleen in deze richting.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a device to its components, sensing or not (e.g. a connection port, power unit, heating element, or functional unit). Inverse-functional: a component belongs to at most one device — no separate isComponentOf property is declared; query in this direction only.</rdfs:comment>
        <rdfs:label xml:lang="en">has component</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderdeel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasComponentOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasComponentOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/ontology#hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasComponentOperationState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasComponentOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een niet-sensorisch onderdeel, bijv. Disconnected of Warning. Een subeigenschap van hasOperationState met een enkel benoemd domein, zodat CSV-gestuurde readout het ondubbelzinnig kan koppelen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a non-sensing component, e.g. Disconnected or Warning. A sub-property of hasOperationState with a single named domain, so CSV-driven readout can attach it unambiguously.</rdfs:comment>
        <rdfs:label xml:lang="en">has component operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderdeeloperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasDeviceOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasDeviceOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/ontology#hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasDeviceOperationState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasDeviceOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een apparaat zelf, bijv. Disconnected. Een subeigenschap van hasOperationState met een enkel benoemd domein, zodat CSV-gestuurde readout het ondubbelzinnig kan koppelen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a device itself, e.g. Disconnected. A sub-property of hasOperationState with a single named domain, so CSV-driven readout can attach it unambiguously.</rdfs:comment>
        <rdfs:label xml:lang="en">has device operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft apparaatoperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasDeviceType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasDeviceType">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasDeviceType</terms:identifier>
        <rdfs:comment xml:lang="nl">Het specifieke type of de modelaanduiding van het apparaat (bijv. ServoU).</rdfs:comment>
        <rdfs:comment xml:lang="en">The specific type or model designation of the device (e.g. ServoU).</rdfs:comment>
        <rdfs:label xml:lang="en">has device type</rdfs:label>
        <rdfs:label xml:lang="nl">heeft apparaattype</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/device-type/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasFunctionalUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasFunctionalUnit">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/ontology#hasComponent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#FunctionalUnit"/>
        <terms:identifier>hasFunctionalUnit</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een apparaat aan een functionele eenheid die het bevat (bijv. een ECG-module, een SpO2-module) — een subeigenschap van hasComponent, aangezien elke functionele eenheid een onderdeel is. Invers-functioneel: een functionele eenheid behoort tot hoogstens één apparaat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a device to a functional unit it houses (e.g. an ECG module, an SpO2 module) — a sub-property of hasComponent, since every functional unit is a component. Inverse-functional: a functional unit belongs to at most one device.</rdfs:comment>
        <rdfs:label xml:lang="en">has functional unit</rdfs:label>
        <rdfs:label xml:lang="nl">heeft functionele eenheid</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasLabelConcept -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasLabelConcept">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#AlarmType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasLabelConcept</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een alarmtype aan zijn gecontroleerde-vocabulaireconcept in het schema van mda:AlarmLabel — één concept per onderscheidend labelstring, gedeeld door elk archetype dat dat label gebruikt, ongeacht prioriteit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an alarm type to its controlled-vocabulary concept in mda:AlarmLabel&apos;s scheme — one concept per distinct label string encountered, shared across every archetype that uses that label regardless of priority (2_READOUT/build_framework.py&apos;s label_concept_iri keys on the label alone, not the archetype). The companion of mda:hasLabel, not a replacement for it.</rdfs:comment>
        <rdfs:label xml:lang="en">has label concept</rdfs:label>
        <rdfs:label xml:lang="nl">heeft labelconcept</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/alarm-label/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasLaterality -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasLaterality">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Laterality"/>
        <terms:identifier>hasLaterality</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een sensor aan zijn lateraliteit (links, rechts, bilateraal). Functioneel: een fysieke sensor heeft op een gegeven moment precies één lateraliteit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor to its laterality (left, right, bilateral). Functional: a physical sensor has exactly one laterality at a time.</rdfs:comment>
        <rdfs:label xml:lang="en">has laterality</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lateraliteit</rdfs:label>
        <refinesParticularIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesParticularIdentity>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasManufacturer">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasManufacturer</terms:identifier>
        <rdfs:comment xml:lang="nl">De fabrikant of productlijn van het apparaat.</rdfs:comment>
        <rdfs:comment xml:lang="en">The manufacturer or product line of the device.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fabrikant</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/manufacturer/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasMessage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasMessage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Alarm"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#AlarmMessage"/>
        <terms:identifier>hasMessage</terms:identifier>
        <rdfs:comment xml:lang="nl">Het bericht van het alarm: een per-alarm mda:AlarmMessage-knooppunt met de onafhankelijke facetten van de gebeurtenis — mda:concernsPatient en mda:triggeredBy — als nevengeschikte eigenschappen, geen van beide via de ander bereikt. Functioneel en invers-functioneel: één alarm heeft precies één bericht en één bericht hoort bij precies één alarm.</rdfs:comment>
        <rdfs:comment xml:lang="en">The alarm&apos;s message: a per-alarm mda:AlarmMessage node carrying the occurrence&apos;s independent facets — mda:concernsPatient (who this alarm is about) and mda:triggeredBy (what caused it) — as siblings, neither reached through the other (see mda:triggeredBy&apos;s comment for why they used to be chained and no longer are). Distinct per alarm so many alarms can reference the same shared patient/device and merge there. Functional and inverse-functional: one alarm has exactly one message and one message belongs to exactly one alarm — alarm_iri/message_iri are minted from the same (device_id, start) key in 4_OPERATIONAL/op_knowledge.py precisely to keep this a bijection.</rdfs:comment>
        <rdfs:label xml:lang="en">has message</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bericht</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasMetricOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasMetricOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/ontology#hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasMetricOperationState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasMetricOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">Of een metriek momenteel wordt gemonitord — anders dan de overige hasOperationState-subeigenschappen nooit CSV-gestuurd; afgeleid door de monitoringsaxioma van FRAMEWORK/KNOWLEDGE_BASE/inference.ttl zodra de metriek een daadwerkelijke interpretatie draagt (hasValueState/hasPhase/hasAggregation/hasRhythm), nooit rechtstreeks toegekend.</rdfs:comment>
        <rdfs:comment xml:lang="en">Whether a metric is currently being monitored — unlike the other hasOperationState sub-properties, never CSV-driven (no CSV column names it); entailed by FRAMEWORK/KNOWLEDGE_BASE/inference.ttl&apos;s Metric monitoring axiom whenever the metric carries an actual interpretation (hasValueState/hasPhase/hasAggregation/hasRhythm), never asserted directly. A sub-property of hasOperationState with a single named domain for the same reason the CSV-driven ones have one: unambiguous attachment for any tooling that walks this property family, even though nothing here reads a CSV column.</rdfs:comment>
        <rdfs:label xml:lang="en">has metric operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft metriekoperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasOperationState">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Component"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Device"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#FunctionalUnit"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Metric"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasOperationState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een apparaat, functionele eenheid, sensor, onderdeel of metriek — apparatuur en de gegevens die zij oplevert. Bewust NIET gedragen door een Signal of een SignalAnalysis: de eigen verantwoording van een signaal is mda:hasQualityState, en een analyse die een metriek heeft opgeleverd draait vanzelfsprekend. De kwaliteitsstatus van een signaal impliceert in plaats daarvan dat de SENSOR Enabled is. Ook bewust NIET gedragen door een TherapeuticModality: een therapie is geen apparatuur, en of zij ongeschonden wordt toegediend is mda:hasTherapyDeliveryQuality, een eigen eigenschap.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a device, functional unit, sensor, component or metric — equipment and the data it yields. Deliberately NOT borne by a Signal or a SignalAnalysis: a signal&apos;s own account of itself is mda:hasQualityState, and an analysis that produced a metric is self-evidently running, so an operational state on either accumulated entailments nothing consumed. A signal&apos;s quality state instead entails its SENSOR is Enabled. Deliberately NOT borne by a TherapeuticModality either: a therapy is not equipment, and whether it is being delivered without compromise is mda:hasTherapyDeliveryQuality, its own property. See the operational-state ladder in FRAMEWORK/KNOWLEDGE_BASE/inference.ttl.</rdfs:comment>
        <rdfs:label xml:lang="en">has operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft operatiestatus</rdfs:label>
        <persistsPostAlarm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</persistsPostAlarm>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasPhase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasPhase">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasPhase</terms:identifier>
        <rdfs:comment xml:lang="nl">Welk deel van één fysiologische cyclus de waarde van de metriek kenmerkt — een punt daarbinnen (systolisch, diastolisch, inspiratoir, eind-expiratoir) of de cyclus als geheel (gemiddeld, teug). Beperkt tot één cyclus: samenstelling over meerdere cycli is mda:hasAggregation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Which part of a single physiological cycle the metric&apos;s value characterises — either a point within it (systolic, diastolic, inspiratory, end-expiratory) or the cycle taken whole (mean, tidal). Confined to one cycle: composition across many cycles is mda:hasAggregation.</rdfs:comment>
        <rdfs:label xml:lang="en">has phase</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fase</rdfs:label>
        <refinesUniversalIdentity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</refinesUniversalIdentity>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/metric-phase/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasPriority -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasPriority">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>hasPriority</terms:identifier>
        <rdfs:comment xml:lang="nl">Het prioriteitsniveau van een alarm of alarmbericht.</rdfs:comment>
        <rdfs:comment xml:lang="en">The priority level of an alarm or alarm message.</rdfs:comment>
        <rdfs:label xml:lang="en">has priority</rdfs:label>
        <rdfs:label xml:lang="nl">heeft prioriteit</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/alarm-priority/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasQualityState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasQualityState">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Signal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasQualityState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasQualityState</terms:identifier>
        <rdfs:comment xml:lang="nl">De kwaliteitsstatus van een signaal, die de meetbetrouwbaarheid aangeeft.</rdfs:comment>
        <rdfs:comment xml:lang="en">The quality state of a signal, indicating measurement reliability.</rdfs:comment>
        <rdfs:label xml:lang="en">has quality state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kwaliteitsstatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/quality-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasRhythm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasRhythm">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasRhythm"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasRhythm</terms:identifier>
        <rdfs:comment xml:lang="nl">Hoe de waarde van de metriek over opeenvolgende cycli in de tijd fluctueert (bijv. onregelmatig, atriumfibrilleren). Onderscheiden van mda:hasValueState, dat één momentane meting tegen een grenswaarde betreft.</rdfs:comment>
        <rdfs:comment xml:lang="en">How the metric&apos;s value fluctuates across successive cycles over time (e.g. irregular, atrial fibrillation). Distinct from mda:hasValueState, which is a single instantaneous reading against a limit.</rdfs:comment>
        <rdfs:label xml:lang="en">has rhythm</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ritme</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/metric-rhythm/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasSensor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasSensor">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#FunctionalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Sensor"/>
        <terms:identifier>hasSensor</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een functionele eenheid aan de fysieke sensor(en) waarvan het afleest (bijv. een ECG-module aan elk van zijn 12 afleidingen). GEEN subeigenschap van hasComponent: het domein is FunctionalUnit, niet Device, en het domein van hasComponent ligt vast op Device. Een sensor behoort niet langer rechtstreeks tot een apparaat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a functional unit to the physical sensor(s) it reads from (e.g. an ECG module to each of its 12 leads). NOT a sub-property of hasComponent: its domain is FunctionalUnit, not Device, and hasComponent&apos;s domain is fixed to Device — declaring it a sub-property would wrongly entail every FunctionalUnit is itself a Device. A sensor no longer belongs directly to a device (see FunctionalUnit below for why: the sensor is the physical probe, the functional unit is what analyses what it picks up). Deliberately NOT owl:InverseFunctionalProperty, unlike most of this file&apos;s other IFP-marked relations: 2_READOUT/outcome/inference.ttl&apos;s FunctionalUnit recipe axioms assert hasSensor via an owl:hasValue restriction, so every alarm typed to the same FunctionalUnit concept (e.g. every FU_PneumoTachograph alarm) entails hasSensor to the SAME shared sensor concept, not a fresh individual per alarm the way 2_READOUT/build_framework.py&apos;s own per-row blank nodes do. Confirmed by an isolated reasoner test: with InverseFunctionalProperty declared, prp-ifp forces every one of those alarms&apos; FunctionalUnit individuals into owl:sameAs with each other — and would do the same across grounded, per-patient data in 4_OPERATIONAL if this property were ever reasoned over there, merging different patients&apos; equipment. mda:producesSignal carries the same latent risk if a future recipe axiom (e.g. the pending ECG one) ever reuses one signal concept across two different sensor concepts — watch for it there too.</rdfs:comment>
        <rdfs:label xml:lang="en">has sensor</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasSensorOperationState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasSensorOperationState">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/ontology#hasOperationState"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasSensorOperationState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasSensorOperationState</terms:identifier>
        <rdfs:comment xml:lang="nl">De operationele status van een sensor, bijv. Enabled, Disabled of Malfunction. Een subeigenschap van hasOperationState met een enkel benoemd domein, zodat CSV-gestuurde readout het ondubbelzinnig kan koppelen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The operational state of a sensor, e.g. Enabled, Disabled, or Malfunction. A sub-property of hasOperationState with a single named domain, so CSV-driven readout can attach it unambiguously.</rdfs:comment>
        <rdfs:label xml:lang="en">has sensor operation state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sensoroperatiestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/operation-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasTherapyDeliveryQuality -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasTherapyDeliveryQuality">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#TherapeuticModality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasTherapyDeliveryQuality"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasTherapyDeliveryQuality</terms:identifier>
        <rdfs:comment xml:lang="nl">Of de therapeutische interventie zelf zonder compromis wordt toegediend, als onderscheiden van de eigen connectiviteit/werking van het toedienende apparaat (hasOperationState) of de meetbetrouwbaarheid van een signaal (hasQualityState). Gedragen door de therapeutische modaliteit, nooit door het apparaat dat deze toedient.</rdfs:comment>
        <rdfs:comment xml:lang="en">Whether the therapeutic intervention itself is being delivered without compromise, as distinct from the administering device&apos;s own connectivity/functioning (hasOperationState) or a signal&apos;s measurement reliability (hasQualityState). Borne by the therapeutic modality, never by the device that administers it.</rdfs:comment>
        <rdfs:label xml:lang="en">has therapy delivery quality</rdfs:label>
        <rdfs:label xml:lang="nl">heeft therapietoedieningskwaliteit</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/quality-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#hasValueState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#hasValueState">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#hasValueState"/>
            <rdf:Description rdf:about="https://w3id.org/mda/ontology#refinesConcept"/>
        </owl:propertyChainAxiom>
        <terms:identifier>hasValueState</terms:identifier>
        <rdfs:comment xml:lang="nl">Waar de waarde van de metriek zich bevindt ten opzichte van de ingestelde alarmgrenzen van het apparaat, zoals het apparaat dit zelf rapporteert (bijv. verhoogd, verlaagd, sterk verlaagd, afwezig). De drempelwaarde waartegen wordt vergeleken is niet gerepresenteerd in dit raamwerk — alleen de uitkomst van de vergelijking.</rdfs:comment>
        <rdfs:comment xml:lang="en">Where the metric&apos;s value sits relative to the device&apos;s configured alarm limits, as the device itself reports it (e.g. increased, decreased, severely decreased, absent). The threshold compared against is not represented in this framework — only the outcome of the comparison.</rdfs:comment>
        <rdfs:label xml:lang="en">has value state</rdfs:label>
        <rdfs:label xml:lang="nl">heeft waardestatus</rdfs:label>
        <valuesFromScheme rdf:resource="https://w3id.org/mda/vocab/metric-value-state/Scheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#isMonitoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#isMonitoredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Patient"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <terms:identifier>isMonitoredBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een patiënt aan het apparaat dat hen op dit moment bewaakt. Invers-functioneel: een apparaat bewaakt hoogstens één patiënt tegelijk.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a patient to the device currently monitoring them. No longer part of the blueprint&apos;s structural path to mda:Device (see mda:triggeredBy) — that routing asserted every alarm-raising device &apos;monitors&apos; the patient, which overclaims for a therapeutic one. What remains is this property&apos;s own, separate justification: inverse-functional, a device monitors at most one patient at a time — a physical monitor is not shared between two patients simultaneously, even though it may serve different patients at different times — so a reasoner can catch a double-booking directly (as an entailed owl:sameAs between two asserted-distinct patients) rather than relying on generator discipline, the same pattern as mda:hasSensor/mda:producesSignal below. Only meaningful if isMonitoredBy is asserted per-instant, not as a standing fact for a patient&apos;s whole encounter — see 4_OPERATIONAL/op_knowledge.py, the only place it is still asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">is monitored by</rdfs:label>
        <rdfs:label xml:lang="nl">wordt bewaakt door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#isOfType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#isOfType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Alarm"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#AlarmType"/>
        <terms:identifier>isOfType</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een concrete alarminstantie aan zijn archetypische alarmtype in de typecatalogus, waaruit standaard structurele kennis (apparaattype, sensortype, signaaltype) kan worden geërfd. Functioneel: één alarminstantie is van precies één archetype.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a concrete alarm instance to its archetypal alarm type in the type catalogue, from which default structural knowledge (device type, sensor type, signal type) can be inherited. Functional: one alarm occurrence is of exactly one archetype.</rdfs:comment>
        <rdfs:label xml:lang="en">is of type</rdfs:label>
        <rdfs:label xml:lang="nl">is van type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#isPropertyOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#isPropertyOf">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProperty"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProcess"/>
        <terms:identifier>isPropertyOf</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een fysiologische eigenschap aan het proces dat het karakteriseert.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a physiological property to the process it characterises.</rdfs:comment>
        <rdfs:label xml:lang="nl">is eigenschap van</rdfs:label>
        <rdfs:label xml:lang="en">is property of</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#organPartOfSystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#organPartOfSystem">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Organ"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#OrganSystem"/>
        <terms:identifier>organPartOfSystem</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een orgaan aan het orgaansysteem waartoe het behoort.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an organ to the organ system it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="nl">orgaan deel van systeem</rdfs:label>
        <rdfs:label xml:lang="en">organ part of system</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#presentIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#presentIn">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProcess"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Organ"/>
        <terms:identifier>presentIn</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een fysiologisch proces aan het orgaan waarin het plaatsvindt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a physiological process to the organ it occurs in.</rdfs:comment>
        <rdfs:label xml:lang="nl">aanwezig in</rdfs:label>
        <rdfs:label xml:lang="en">present in</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#processPartOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#processPartOf">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProcess"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProcess"/>
        <terms:identifier>processPartOf</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een fysiologisch proces aan het grotere fysiologische proces waarvan het een samenstellend deel is.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a physiological process to the larger physiological process it is a constituent part of.</rdfs:comment>
        <rdfs:label xml:lang="nl">proces deel van</rdfs:label>
        <rdfs:label xml:lang="en">process part of</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#producesMetric -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#producesMetric">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#SignalAnalysis"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Metric"/>
        <terms:identifier>producesMetric</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een signaalanalysestap aan de metriek die het berekent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a signal-analysis step to the metric it computes.</rdfs:comment>
        <rdfs:label xml:lang="nl">produceert metriek</rdfs:label>
        <rdfs:label xml:lang="en">produces metric</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#producesSignal -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#producesSignal">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Sensor"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#SignalAnalysis"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Signal"/>
        <terms:identifier>producesSignal</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een sensor OF een signaalanalysestap aan het signaal dat het produceert — het ruwe signaal van een sensor, of het afgeleide/tussenliggende signaal van een analysestap (bijv. een afleiding zoals aVF, afgeleid uit de ruwe signalen van de elektroden). Invers-functioneel: een signaal heeft hoogstens één producent, ongeacht het soort.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sensor OR a signal-analysis step to the signal it produces — a sensor&apos;s raw signal, or an analysis step&apos;s derived/intermediate signal (e.g. a lead such as aVF, derived from the electrodes&apos; raw signals). Inverse-functional: a signal has at most one producer, whichever kind produced it. Its domain is a union; ontology_tree.py&apos;s derive_class_tree expands union domains, but leaves the Sensor member to mda:sensorProducesSignal, the single-domain sub-property that carries that edge — so the CSV/tree derivation in CODE/framework_build/build_framework.py attaches Signal under Sensor exactly once. A signal-analysis step&apos;s own derived-signal output (the aVF case) is only ever hand-authored in inference.ttl, never CSV-driven, so it uses this general property directly and needs no sub-property of its own.</rdfs:comment>
        <rdfs:label xml:lang="nl">produceert signaal</rdfs:label>
        <rdfs:label xml:lang="en">produces signal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#refinesConcept -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#refinesConcept">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:identifier>refinesConcept</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een waardeconcept aan het bredere waardeconcept waarvan het altijd een geval is, binnen één schema (bijv. kwaliteitsstatus Pulseless aan Impaired). Via de eigenschapsketens op de waarde-eigenschappen draagt een knoop met de nauwere waarde ook de bredere.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a value concept to the broader value concept it is always a case of, within one scheme (e.g. quality state Pulseless to Impaired). Through the property chains declared on the value properties, a node bearing the narrower value also bears the broader one. Curated in FRAMEWORK/VOCABULARY/seed/hierarchy.ttl.</rdfs:comment>
        <rdfs:label xml:lang="en">refines concept</rdfs:label>
        <rdfs:label xml:lang="nl">verfijnt concept</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#sensorProducesSignal -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#sensorProducesSignal">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mda/ontology#producesSignal"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Sensor"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Signal"/>
        <terms:identifier>sensorProducesSignal</terms:identifier>
        <rdfs:comment xml:lang="nl">Het CSV/boom-gerichte geval van mda:producesSignal: het eigen ruwe signaal van een sensor. Een subeigenschap met één domein, zodat de door 2_READOUT/build_framework.py afgeleide boom Signal ondubbelzinnig onder Sensor kan hangen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The CSV/tree-facing case of mda:producesSignal: a sensor&apos;s own raw signal. A single-domain sub-property that carries the Sensor -&gt; Signal edge in the ontology-derived tree (ontology_tree.py leaves that member of mda:producesSignal&apos;s union domain to it) — see mda:producesSignal&apos;s comment. Every fact asserted through it still entails the general mda:producesSignal fact (and, transitively, mda:hasOperationState&apos;s propagation chain) via rdfs:subPropertyOf.</rdfs:comment>
        <rdfs:label xml:lang="nl">sensor produceert signaal</rdfs:label>
        <rdfs:label xml:lang="en">sensor produces signal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#targetsProcess -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#targetsProcess">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#TherapeuticModality"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#PhysiologicalProcess"/>
        <terms:identifier>targetsProcess</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een therapeutische modaliteit aan het fysiologische proces waarop het zich richt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a therapeutic modality to the physiological process it targets.</rdfs:comment>
        <rdfs:label xml:lang="nl">richt zich op proces</rdfs:label>
        <rdfs:label xml:lang="en">targets process</rdfs:label>
        <situational rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</situational>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/mda/ontology#triggeredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/mda/ontology#triggeredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#AlarmMessage"/>
        <rdfs:range rdf:resource="https://w3id.org/mda/ontology#Device"/>
        <terms:identifier>triggeredBy</terms:identifier>
        <rdfs:comment xml:lang="nl">Koppelt een alarmbericht rechtstreeks aan het apparaat waarvan het de technische structuur impliceert — de enige weg van AlarmMessage naar de mda:Device-deelboom. Vervangt routering via mda:concernsPatient/mda:isMonitoredBy: die keten beweerde dat elk alarmerend apparaat de patiënt &apos;bewaakt&apos;, wat onjuist is voor een wezenlijk therapeutisch apparaat. mda:isMonitoredBy zelf is ONGEWIJZIGD en blijft gebruikt, maar uitsluitend voor de eigen operationele rechtvaardiging. Functioneel, niet invers-functioneel.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an alarm message directly to the device whose technical structure it implicates — the sole path from AlarmMessage into the mda:Device subtree (mda:hasFunctionalUnit, mda:hasSensor, ...). Replaces routing that reach through mda:concernsPatient/mda:isMonitoredBy: that chain asserted every alarm-raising device &apos;monitors&apos; the patient, which is false for a fundamentally therapeutic device (mda:MechanicalVentilator, mda:Dialysator, mda:ExtracorporealMembraneOxygenator, mda:Incubator/mda:Thermoregulator all administer a therapy — see mda:administers — rather than principally observe). mda:isMonitoredBy itself is UNCHANGED and still used, but only for its own actual justification: 4_OPERATIONAL/op_knowledge.py&apos;s per-instant double-booking check, asserted fresh at grounding time, never derived from or dependent on this blueprint-level structure. Functional, not inverse-functional: one message has exactly one triggering device, but one device triggers many messages over its lifetime — unlike mda:hasMessage&apos;s strict bijection.</rdfs:comment>
        <rdfs:label xml:lang="en">triggered by</rdfs:label>
        <rdfs:label xml:lang="nl">veroorzaakt door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/mda/ontology#hasDuration -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/ontology#hasDuration">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#Alarm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <terms:identifier>hasDuration</terms:identifier>
        <rdfs:comment xml:lang="nl">De duur van het alarm, als ISO 8601-duur (bijv. PT30S).</rdfs:comment>
        <rdfs:comment xml:lang="en">The duration of the alarm, as an ISO 8601 duration (e.g. PT30S).</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <rdfs:label xml:lang="nl">heeft duur</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/mda/ontology#hasEnd -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/ontology#hasEnd">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Alarm"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#ClinicalEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <terms:identifier>hasEnd</terms:identifier>
        <rdfs:comment xml:lang="nl">Het eindtijdstip van een alarm, of van een klinische gebeurtenis — voor de laatste het moment waarop haar bewijscriterium ophield te gelden, nooit het moment waarop een toepassing dat opmerkte. Een lopende klinische gebeurtenis heeft nog geen einde.</rdfs:comment>
        <rdfs:comment xml:lang="en">The end time of an alarm, or of a clinical event — for the latter, the moment its evidence criterion stopped holding, never the moment an application noticed. An ongoing clinical event has no end yet.</rdfs:comment>
        <rdfs:label xml:lang="en">has end</rdfs:label>
        <rdfs:label xml:lang="nl">heeft einde</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/mda/ontology#hasLabel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/ontology#hasLabel">
        <rdfs:domain rdf:resource="https://w3id.org/mda/ontology#AlarmType"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <terms:identifier>hasLabel</terms:identifier>
        <rdfs:comment xml:lang="nl">Het vrije-tekstlabel dat een alarmtype identificeert, exact zoals het in de brondata voorkomt — een literal, geen concept. mda:hasLabelConcept is de bijbehorende gecontroleerde-vocabulaire lezing van hetzelfde label; beide worden bewust bijgehouden. AlarmType is het enige domein; een Alarm-instantie bereikt zijn label via mda:isOfType.</rdfs:comment>
        <rdfs:comment xml:lang="en">The free-text label identifying an alarm type, exactly as it occurs in the source data (e.g. &apos;PHILIPSMONITOR - SpO2 geen pols&apos;) — a literal, not a concept: alarm labels routinely contain spaces and punctuation no SKOS notation can carry. mda:hasLabelConcept is the companion controlled-vocabulary reading of the same label — the two are deliberately BOTH kept, not alternatives: this ontology wants both the label as encountered and a stable, deduplicated vocabulary entry for it (the same label recurs across archetypes that differ only in priority). AlarmType is its only domain; a plain Alarm instance reaches its label via mda:isOfType.</rdfs:comment>
        <rdfs:label xml:lang="en">has label</rdfs:label>
        <rdfs:label xml:lang="nl">heeft label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/mda/ontology#hasStart -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/mda/ontology#hasStart">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#Alarm"/>
                    <rdf:Description rdf:about="https://w3id.org/mda/ontology#ClinicalEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <terms:identifier>hasStart</terms:identifier>
        <rdfs:comment xml:lang="nl">Het starttijdstip van een alarm, of van een klinische gebeurtenis — voor de laatste het moment waarop haar bewijscriterium (clinicalEvents.ttl) voor het eerst gold.</rdfs:comment>
        <rdfs:comment xml:lang="en">The start time of an alarm, or of a clinical event — for the latter, the moment its evidence criterion (clinicalEvents.ttl) first held.</rdfs:comment>
        <rdfs:label xml:lang="en">has start</rdfs:label>
        <rdfs:label xml:lang="nl">heeft start</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- https://w3id.org/mda/ontology#Alarm -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Alarm">
        <terms:identifier>Alarm</terms:identifier>
        <rdfs:comment xml:lang="en">A notification or alert generated by a medical device.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een melding of waarschuwing gegenereerd door een medisch apparaat.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm</rdfs:label>
        <rdfs:label xml:lang="nl">Alarm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#AlarmMessage -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#AlarmMessage">
        <terms:identifier>AlarmMessage</terms:identifier>
        <rdfs:comment xml:lang="en">A per-alarm message node — the hub for this occurrence&apos;s independent facets: mda:concernsPatient (the shared, persistent patient — the merge anchor operational inference reasons across alarms over) and mda:triggeredBy (the device whose technical structure this alarm implicates), reached as siblings rather than one gatewaying the other.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een per-alarm berichtknooppunt — het knooppunt voor de onafhankelijke facetten van deze gebeurtenis: mda:concernsPatient en mda:triggeredBy, als nevengeschikte eigenschappen bereikt.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm Message</rdfs:label>
        <rdfs:label xml:lang="nl">Alarmbericht</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#AlarmType -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#AlarmType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/ontology#Alarm"/>
        <terms:identifier>AlarmType</terms:identifier>
        <rdfs:comment xml:lang="en">A generic, archetypal alarm definition independent of any specific device instance or patient encounter. Captures the default device, sensor, and signal structure associated with a class of alarm.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een generieke, archetypische alarmdefinitie, onafhankelijk van een specifieke apparaatinstantie of patiëntencounter. Legt de standaard apparaat-, sensor- en signaalstructuur vast die samenhangt met een klasse van alarmen.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm Type</rdfs:label>
        <rdfs:label xml:lang="nl">Alarmtype</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#AnatomicalPosition -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#AnatomicalPosition">
        <terms:identifier>AnatomicalPosition</terms:identifier>
        <rdfs:comment xml:lang="nl">De anatomische positie van een sensor op het lichaam.</rdfs:comment>
        <rdfs:comment xml:lang="en">The anatomical position of a sensor on the body.</rdfs:comment>
        <rdfs:label xml:lang="en">Anatomical Position</rdfs:label>
        <rdfs:label xml:lang="nl">Anatomische Positie</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Referential"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#ClinicalEvent -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#ClinicalEvent">
        <terms:identifier>ClinicalEvent</terms:identifier>
        <rdfs:comment xml:lang="en">A discrete, acute clinical judgement about one patient — e.g. a cardiac arrest — individuated per occurrence. It concerns exactly one patient (mda:concernsPatient), is believed because of the evidence it points to (mda:evidencedBy), and holds from mda:hasStart until mda:hasEnd. Which evidence each kind of event requires is stated on the event class itself, in clinicalEvents.ttl. Its concrete kind is given by a concept from the clinical-event scheme, used as its rdf:type.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een afzonderlijk, acuut klinisch oordeel over één patiënt — bijv. een hartstilstand — per voorval geïndividualiseerd. Zij betreft precies één patiënt (mda:concernsPatient), wordt aangenomen op grond van het bewijs waarnaar zij verwijst (mda:evidencedBy), en geldt van mda:hasStart tot mda:hasEnd. Welk bewijs elke soort gebeurtenis vereist, staat op de gebeurtenisklasse zelf, in clinicalEvents.ttl. De concrete soort wordt gegeven door een concept uit het klinische-gebeurtenisschema, gebruikt als rdf:type.</rdfs:comment>
        <rdfs:label xml:lang="en">Clinical Event</rdfs:label>
        <rdfs:label xml:lang="nl">Klinische Gebeurtenis</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Component -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Component">
        <terms:identifier>Component</terms:identifier>
        <rdfs:comment xml:lang="en">A physical or functional part of a medical device (e.g. a connection port, power unit, or heating element). mda:Sensor is the specialisation that additionally produces a measurable signal — every sensor is a component, but not every component senses.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een fysiek of functioneel onderdeel van een medisch apparaat (bijv. een aansluitpoort, voedingseenheid of verwarmingselement). mda:Sensor is de specialisatie die daarnaast een meetbaar signaal produceert — elke sensor is een onderdeel, maar niet elk onderdeel meet.</rdfs:comment>
        <rdfs:label xml:lang="en">Component</rdfs:label>
        <rdfs:label xml:lang="nl">Onderdeel</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#CriticalComponent -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#CriticalComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/ontology#Component"/>
        <terms:identifier>CriticalComponent</terms:identifier>
        <rdfs:comment xml:lang="nl">De subklasse van mda:Component waarvan het loskoppelen betekent dat het apparaat zelf niet beschikbaar is (bijv. de datapoort, de stroomaansluiting) — in tegenstelling tot een randonderdeel waarvan het loskoppelen slechts een subsysteemwaarschuwing is (bijv. een matrasverwarming).</rdfs:comment>
        <rdfs:comment xml:lang="en">The subclass of mda:Component whose own disconnection means the device itself is unavailable (e.g. the data-link port, the power inlet) — as opposed to a peripheral component whose disconnection is only a subsystem-level warning (e.g. a mattress heater). This class exists so the propagation rule using it can be precise: unconditionally true for CriticalComponent, never assumed for mda:Component as a whole — see mda:hasOperationState&apos;s comment below on why mda:hasComponent was deliberately dropped from its propertyChainAxiom. The rule itself, and which concrete vocabulary-level component types (e.g. component:ConnectionUnit, component:PowerUnit) are tagged as members of this class, both live in 2_READOUT/outcome/inference.ttl&apos;s Component operational-state propagation section — the rule&apos;s hasValue target (a specific operation-state concept) is catalogue vocabulary, so it cannot be asserted here, but this class it&apos;s written over is a plain structural distinction with no vocabulary dependency, so it belongs in this TBox, not duplicated per component type down there.</rdfs:comment>
        <rdfs:label xml:lang="en">Critical component</rdfs:label>
        <rdfs:label xml:lang="nl">Kritiek onderdeel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Device -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Device">
        <terms:identifier>Device</terms:identifier>
        <rdfs:comment xml:lang="en">A medical device that generates alarms.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een medisch apparaat dat alarmen genereert.</rdfs:comment>
        <rdfs:label xml:lang="nl">Apparaat</rdfs:label>
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#FunctionalUnit -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#FunctionalUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/ontology#Component"/>
        <owl:disjointWith rdf:resource="https://w3id.org/mda/ontology#Sensor"/>
        <terms:identifier>FunctionalUnit</terms:identifier>
        <rdfs:comment xml:lang="nl">De module van een apparaat die de berekeningslogica voor een bepaalde meetmogelijkheid huisvest (bijv. een ECG-module, een SpO2-module) — in de volksmond vaak &apos;de sensor&apos; genoemd, maar hier onderscheiden van mda:Sensor, dat enkel de fysieke probe is. Een functionele eenheid leest van één of meer sensoren en zet, via één of meer mda:SignalAnalysis-stappen, hun signalen om in metrieken. Een specialisatie van mda:Component. Disjunct verklaard met mda:Sensor vanwege precies die volkstaal-verwarring.</rdfs:comment>
        <rdfs:comment xml:lang="en">The module of a device that houses the computation logic for a particular measurement capability (e.g. an ECG module, an SpO2 module) — often called &apos;the sensor&apos; colloquially, but distinct here from mda:Sensor, which is only the physical probe. A functional unit reads from one or more sensors and, via one or more mda:SignalAnalysis steps, turns their signals into metrics. A specialisation of mda:Component. Declared disjoint with mda:Sensor precisely because of that colloquial conflation — the two are easy to confuse in exactly the way this class&apos;s own name tries to prevent, so a node accidentally typed as both is now an inconsistency a reasoner catches rather than a silent modelling error.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional unit</rdfs:label>
        <rdfs:label xml:lang="nl">Functionele eenheid</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Laterality -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Laterality">
        <terms:identifier>Laterality</terms:identifier>
        <rdfs:comment xml:lang="nl">De lateraliteit (links, rechts, bilateraal) van een sensorpositie.</rdfs:comment>
        <rdfs:comment xml:lang="en">The laterality (left, right, bilateral) of a sensor position.</rdfs:comment>
        <rdfs:label xml:lang="nl">Lateraliteit</rdfs:label>
        <rdfs:label xml:lang="en">Laterality</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Referential"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Metric -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Metric">
        <terms:identifier>Metric</terms:identifier>
        <rdfs:comment xml:lang="en">A measurable quantity, computed by a mda:SignalAnalysis step from one or more signals, or derived from other metrics (a metric can itself be the input of a further step, via mda:analyzedBy).</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een meetbare grootheid, berekend door een mda:SignalAnalysis-stap uit één of meer signalen, of afgeleid uit andere metrieken.</rdfs:comment>
        <rdfs:label xml:lang="en">Metric</rdfs:label>
        <rdfs:label xml:lang="nl">Metriek</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Stateful"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Organ -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Organ">
        <terms:identifier>Organ</terms:identifier>
        <rdfs:comment xml:lang="en">A biological organ.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een biologisch orgaan.</rdfs:comment>
        <rdfs:label xml:lang="nl">Orgaan</rdfs:label>
        <rdfs:label xml:lang="en">Organ</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Referential"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#OrganSystem -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#OrganSystem">
        <terms:identifier>OrganSystem</terms:identifier>
        <rdfs:comment xml:lang="en">A system of related organs in the body.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een systeem van gerelateerde organen in het lichaam.</rdfs:comment>
        <rdfs:label xml:lang="nl">Orgaansysteem</rdfs:label>
        <rdfs:label xml:lang="en">Organ System</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Referential"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Patient -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Patient">
        <terms:identifier>Patient</terms:identifier>
        <rdfs:comment xml:lang="en">A patient being monitored by medical devices.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een patiënt die wordt bewaakt door medische apparaten.</rdfs:comment>
        <rdfs:label xml:lang="en">Patient</rdfs:label>
        <rdfs:label xml:lang="nl">Patiënt</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#PhysiologicalProcess -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#PhysiologicalProcess">
        <terms:identifier>PhysiologicalProcess</terms:identifier>
        <rdfs:comment xml:lang="en">A biological or physiological process occurring in the body.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een biologisch of fysiologisch proces dat in het lichaam plaatsvindt.</rdfs:comment>
        <rdfs:label xml:lang="nl">Fysiologisch Proces</rdfs:label>
        <rdfs:label xml:lang="en">Physiological Process</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Referential"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#PhysiologicalProperty -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#PhysiologicalProperty">
        <terms:identifier>PhysiologicalProperty</terms:identifier>
        <rdfs:comment xml:lang="en">A measurable property of a physiological process.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een meetbare eigenschap van een fysiologisch proces.</rdfs:comment>
        <rdfs:label xml:lang="nl">Fysiologische Eigenschap</rdfs:label>
        <rdfs:label xml:lang="en">Physiological Property</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Referential"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#PostAlarmValidScheme -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#PostAlarmValidScheme">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:identifier>PostAlarmValidScheme</terms:identifier>
        <rdfs:comment xml:lang="en">A SKOS concept scheme whose concepts remain valid for a fixed duration after an alarm ends.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een SKOS-conceptschema waarvan de concepten geldig blijven gedurende een vaste duur nadat een alarm is geëindigd.</rdfs:comment>
        <rdfs:label xml:lang="nl">Post-alarm geldig schema</rdfs:label>
        <rdfs:label xml:lang="en">Post-alarm valid scheme</rdfs:label>
        <postAlarmValidityDuration rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT15M</postAlarmValidityDuration>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Sensor -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Sensor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/mda/ontology#Component"/>
        <terms:identifier>Sensor</terms:identifier>
        <rdfs:comment xml:lang="nl">Het fysieke object dat geplaatst wordt om een signaal te genereren — bijv. een pulse-oximetrieklip, een ECG-afleiding, een temperatuurprobe. Het reageert op een stimulus en produceert een ruw signaal (mda:producesSignal); het berekent niets. Dat signaal omzetten in een metriek is de taak van mda:FunctionalUnit, via mda:SignalAnalysis. Een specialisatie van mda:Component.</rdfs:comment>
        <rdfs:comment xml:lang="en">The physical object placed to generate a signal — e.g. a pulse-oximetry clip, an ECG lead, a temperature probe. It responds to a stimulus and produces a raw signal (mda:producesSignal); it computes nothing. Turning that signal into a metric is mda:FunctionalUnit&apos;s job, via mda:SignalAnalysis. A specialisation of mda:Component. Declared disjoint with mda:FunctionalUnit (see its own comment) — asserted there, applies symmetrically.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <rdfs:label xml:lang="nl">Sensor</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#Signal -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#Signal">
        <terms:identifier>Signal</terms:identifier>
        <rdfs:comment xml:lang="en">A signal — either raw, produced by a sensor, or derived/intermediate, produced by a mda:SignalAnalysis step from other signals (e.g. augmented lead aVF, derived from the RA, LA and LL raw signals). No structural distinction between the two: a later analysis step consuming a signal doesn&apos;t need to know whether it came from a sensor or from an earlier analysis.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een signaal — ofwel ruw, geproduceerd door een sensor, ofwel afgeleid/tussenliggend, geproduceerd door een mda:SignalAnalysis-stap uit andere signalen (bijv. versterkte afleiding aVF, afgeleid uit de ruwe RA-, LA- en LL-signalen). Geen structureel onderscheid tussen beide: een latere analysestap die een signaal verbruikt hoeft niet te weten of het van een sensor komt of van een eerdere analyse.</rdfs:comment>
        <rdfs:label xml:lang="nl">Signaal</rdfs:label>
        <rdfs:label xml:lang="en">Signal</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#SignalAnalysis -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#SignalAnalysis">
        <terms:identifier>SignalAnalysis</terms:identifier>
        <rdfs:comment xml:lang="nl">Eén berekeningsstap van een functionele eenheid: verbruikt één of meer signalen en/of metrieken (bereikt via de inverse van mda:analyzedBy) en produceert ofwel een metriek (mda:producesMetric) ofwel een verder afgeleid signaal (mda:producesSignal) dat een latere stap op zijn beurt kan verbruiken. Zelf geen mda:Component — het is de berekening die een functionele eenheid uitvoert, geen fysiek onderdeel.</rdfs:comment>
        <rdfs:comment xml:lang="en">One computation step of a functional unit: consumes one or more signals and/or metrics (reached via the inverse of mda:analyzedBy) and produces either a metric (mda:producesMetric) or a further, derived signal (mda:producesSignal) that a later step can itself consume. Not itself a mda:Component — it&apos;s the computation a functional unit performs, not a physical part. A step with metric inputs produces exactly one metric: one step with several inputs and several outputs would lose which input feeds which output. The class keeps the name SignalAnalysis for its signal-consuming origin; renaming it would touch every consumer for no change in meaning.</rdfs:comment>
        <rdfs:label xml:lang="nl">Signaalanalyse</rdfs:label>
        <rdfs:label xml:lang="en">Signal analysis</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- https://w3id.org/mda/ontology#TherapeuticModality -->


    <owl:Class rdf:about="https://w3id.org/mda/ontology#TherapeuticModality">
        <terms:identifier>TherapeuticModality</terms:identifier>
        <rdfs:comment xml:lang="en">A therapeutic intervention or treatment modality.</rdfs:comment>
        <rdfs:comment xml:lang="nl">Een therapeutische interventie of behandelingsmodaliteit.</rdfs:comment>
        <rdfs:label xml:lang="en">Therapeutic Modality</rdfs:label>
        <rdfs:label xml:lang="nl">Therapeutische Modaliteit</rdfs:label>
        <nodeKind rdf:resource="https://w3id.org/mda/ontology#Individuated"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/mda/ontology#Individuated -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mda/ontology#Individuated">
        <rdfs:label xml:lang="en">individuated</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mda/ontology#Referential -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mda/ontology#Referential">
        <rdfs:label xml:lang="en">referential</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mda/ontology#Stateful -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mda/ontology#Stateful">
        <rdfs:label xml:lang="en">stateful</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://w3id.org/mda/vocab/anatomical-position/Scheme">
        <instantiatesClass rdf:resource="https://w3id.org/mda/ontology#AnatomicalPosition"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/mda/vocab/clinical-event/Scheme">
        <instantiatesClass rdf:resource="https://w3id.org/mda/ontology#ClinicalEvent"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/mda/vocab/component/Scheme">
        <instantiatesClass rdf:resource="https://w3id.org/mda/ontology#Component"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/mda/vocab/device/Scheme">
