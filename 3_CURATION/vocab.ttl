        "Longen"@nl .

organ:Heart a skos:Concept ;
    rdfs:subClassOf mda:Organ ;
    skos:broader organ:Organ ;
    skos:definition "The muscular organ that pumps blood through the circulatory system by rhythmic contraction."@en,
        "Het spierorgaan dat bloed door het lichaam pompt door middel van ritmische samentrekking."@nl ;
    skos:inScheme organ:Scheme ;
    skos:notation "Heart" ;
