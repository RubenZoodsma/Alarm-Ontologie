organSystem:OrganSystem a skos:Concept ;
    skos:definition "A group of organs that work together to perform one or more functions in an organism."@en,
        "Een groep organen die samenwerken om één of meer functies in een organisme uit te voeren."@nl ;
    skos:inScheme organSystem:Scheme ;
    skos:notation "OrganSystem" ;
    skos:prefLabel "Organ System"@en,
        "Orgaansysteem"@nl ;
    skos:topConceptOf organSystem:Scheme .

organSystem:Pulmonary a skos:Concept ;
    rdfs:subClassOf mda:OrganSystem ;
    skos:broader organSystem:OrganSystem ;
    skos:definition "The system responsible for gas exchange between the body and the environment, comprising the lungs and airways."@en,
        "Het systeem verantwoordelijk voor gasuitwisseling tussen het lichaam en de omgeving, bestaande uit de longen en luchtwegen."@nl ;
    skos:inScheme organSystem:Scheme ;
    skos:notation "Pulmonary" ;
    skos:prefLabel "Pulmonary System"@en,
        "Pulmonaal Systeem"@nl .

organSystem:CardioVascular a skos:Concept ;
    rdfs:subClassOf mda:OrganSystem ;
    skos:broader organSystem:OrganSystem ;
    skos:definition "The system responsible for circulating blood through the body, comprising the heart and blood vessels."@en,
        "Het systeem verantwoordelijk voor de bloedsomloop door het lichaam, bestaande uit het hart en de bloedvaten."@nl ;
    skos:inScheme organSystem:Scheme ;
    skos:notation "CardioVascular" ;
    skos:prefLabel "CardioVascular System"@en,
        "Cardiovasculair Systeem"@nl .

organ:Organ a skos:Concept ;
    skos:definition "A part of an organism that is typically self-contained and has a specific vital function, such as the heart or liver."@en,
        "Een deel van een organisme dat typisch zelfvoorzienend is en een specifieke vitale functie heeft, zoals het hart of de lever."@nl ;
    skos:inScheme organ:Scheme ;
    skos:notation "Organ" ;
    skos:prefLabel "Organ"@en,
        "Orgaan"@nl ;
    skos:topConceptOf organ:Scheme .

organ:Lungs a skos:Concept ;
    rdfs:subClassOf mda:Organ ;
    skos:broader organ:Organ ;
    skos:definition "The paired respiratory organs in which gas exchange with the blood occurs."@en,
