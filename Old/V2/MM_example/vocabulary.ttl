############################################################
# Medium scheme
############################################################

med:Scheme              a skos:ConceptScheme ;
  skos:prefLabel        "Media"@en, "Media"@nl .

med:Medium              a skos:Concept ;
  skos:inScheme         med:Scheme ;
  skos:topConceptOf     med:Scheme ;
  skos:prefLabel        "Medium"@en, "Medium"@nl ;
  skos:definition       "Medium"@en, "Medium"@nl ;
  skos:notation         "Medium" .

med:Physical            a skos:Concept ;
  skos:inScheme         med:Scheme ;
  skos:broader          med:Medium ;
  skos:prefLabel        "Physical"@en, "Fysiek Gesprek"@nl ;
  skos:definition       "Physical"@en, "Fysiek Gesprek"@nl ;
  skos:notation         "Physical" ;
  opp:channel           channel:Physical ;
  opp:timing            timing:Synchronous .

med:Phone               a skos:Concept ;
  skos:inScheme         med:Scheme ;
  skos:broader          med:Medium ;
  skos:prefLabel        "Phone"@en, "Telefoongesprek"@nl ;
  skos:definition       "Phone"@en, "Telefoongesprek"@nl ;
  skos:notation         "Phone" ;
