sp:Authorized           a skos:Concept ;
    skos:inScheme       sp:Scheme ;
    skos:broader        sp:SchedulingPolicy ;
    skos:prefLabel      "Authorized"@en, "Authorized"@nl ;
    skos:definition     "Item can be scheduled directly"@en, "Item can be scheduled directly"@nl ;
    skos:notation       "Authorized" .

sp:ExternalValidation   a skos:Concept ;
    skos:inScheme       sp:Scheme ;
    skos:broader        sp:SchedulingPolicy ;
    skos:prefLabel      "External validation"@en, "External validation"@nl ;
    skos:definition     "Item requires external validation (e.g. contacting relevant outpatient clinic) before scheduling"@en,
                        "Item requires external validation (e.g. contacting relevant outpatient clinic) before scheduling"@nl ;
    skos:notation       "ExternalValidation" .


