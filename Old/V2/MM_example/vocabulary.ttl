@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .


############################################################
# Channel scheme
############################################################

channel:Scheme          a skos:ConceptScheme ; 
    skos:prefLabel      "Channel"@en, "Channel"@nl .

channel:Channel         a skos:Concept ;
    skos:inScheme       channel:Scheme ;
    skos:topConceptOf   channel:Scheme ;
    skos:prefLabel      "Channel"@en, "Channel"@nl ;
    skos:definition     "Channel"@en, "Channel"@nl ;
    skos:notation       "Channel" .

channel:Physical        a skos:Concept  ;
    skos:inScheme       channel:Scheme ;
    skos:broader        channel:Channel ;
    skos:prefLabel      "Physical"@en, "Physical"@nl ;
    skos:definition     "Physical"@en, "Physical"@nl ;
    skos:notation       "Physical" . 

channel:Virtual         a skos:Concept ;
    skos:inScheme       channel:Scheme ;
    skos:broader        channel:Channel ;
    skos:prefLabel      "Virtual"@en, "Virtual"@nl ;
    skos:definition     "Virtual"@en, "Virtual"@nl ;
    skos:notation       "Virtual" .


