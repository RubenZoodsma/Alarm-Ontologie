############################################################
# Date Time Format scheme
############################################################


datetime:Scheme         a skos:ConceptScheme ;
    skos:prefLabel      "DateTimeFormat"@en, "DateTimeFormat"@nl .

datetime:DateTimeFormat a skos:Concept ;
    skos:inScheme       datetime:Scheme ;
    skos:topConceptOf   datetime:Scheme ;
    skos:prefLabel      "DateTimeFormat"@en, "DateTimeFormat"@nl ;
    skos:definition     "DateTimeFormat"@en, "DateTimeFormat"@nl ;
    skos:notation       "DateTimeFormat" .

datetime:DateOnly       a skos:Concept ;
    skos:inScheme       datetime:Scheme ;
    skos:broader        datetime:DateTimeFormat ;
    skos:prefLabel      "DateOnly"@en, "DateOnly"@nl ;
    skos:definition     "A date in the standardized ISO 8601 format yyyy-MM-dd"@en,
                        "A date in the standardized ISO 8601 format yyyy-MM-dd"@nl ;
    skos:notation       "yyyy-MM-dd" .

datetime:MonthDay       a skos:Concept ;
    skos:inScheme       datetime:Scheme ;
    skos:broader        datetime:DateTimeFormat ;
    skos:prefLabel      "MonthDay"@en, "MonthDay"@nl ;
    skos:definition     "A month and day in the standardized ISO 8601 format MM-dd"@en,
                        "A month and day in the standardized ISO 8601 format MM-dd"@nl ;
    skos:notation       "MM-dd" .

datetime:TimeOnly       a skos:Concept ;
    skos:inScheme       datetime:Scheme ;
    skos:broader        datetime:DateTimeFormat ;
    skos:prefLabel      "TimeOnly"@en, "TimeOnly"@nl ;
    skos:definition     "A time in the standardized ISO 8601 format HH:mm:ss"@en,
                        "A time in the standardized ISO 8601 format HH:mm:ss"@nl ;
    skos:notation       "HH:mm:ss" .

datetime:DayOfWeek       a skos:Concept ;
    skos:inScheme       datetime:Scheme ;
    skos:broader        datetime:DateTimeFormat ;
    skos:prefLabel      "DayOfWeek"@en, "DayOfWeek"@nl ;
    skos:definition     "A day of the week represented as an integer, where Monday is 0 and Sunday is 6"@en,
                        "A day of the week represented as an integer, where Monday is 0 and Sunday is 6"@nl .


