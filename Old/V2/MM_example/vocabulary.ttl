############################################################
# Required Plan Horizon scheme
############################################################

rph:Scheme              a skos:ConceptScheme ;
    skos:prefLabel      "Required Plan Horizon"@en, "Required Plan Horizon"@nl .

rph:RequiredPlanHorizon a skos:Concept ;
    skos:inScheme       rph:Scheme ;
    skos:topConceptOf   rph:Scheme ;
    skos:prefLabel      "Required plan horizon status"@en, "Required plan horizon status"@nl ;
    skos:definition     "Required plan horizon status"@en, "Required plan horizon status"@nl ;
    skos:notation       "RequiredPlanHorizon" .

rph:AboveMaxPlanHorizon a skos:Concept ;
    skos:inScheme       rph:Scheme ;
    skos:broader        rph:RequiredPlanHorizon ;
    skos:prefLabel      "Above max plan horizon"@en,  "Above max plan horizon"@nl ;
    skos:definition     "Minimum required length of this series is above maximum HiX planhorizon of 14 weeks"@en,
                        "Minimum required length of this series is above maximum HiX planhorizon of 14 weeks"@nl ;
    skos:notation       "AboveMaxPlanHorizon" .

rph:BelowMaxPlanHorizon a skos:Concept ;
    skos:inScheme       rph:Scheme ;
    skos:broader        rph:RequiredPlanHorizon ;
    skos:prefLabel      "Below max plan horizon"@en, "Below max plan horizon"@nl ;
    skos:definition     "Minimum required length of this series is below maximum HiX planhorizon of 14 weeks"@en,
                        "Minimum required length of this series is below maximum HiX planhorizon of 14 weeks"@nl ;
    skos:notation       "BelowMaxPlanHorizon" .


