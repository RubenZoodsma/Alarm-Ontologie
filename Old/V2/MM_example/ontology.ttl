@prefix opp:        <http://example.org/poliplanning#> .

@prefix dc:         <http://purl.org/dc/elements/1.1/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:       <http://purl.org/vocab/vann/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .


<http://example.org/poliplanning#>  a owl:Ontology ;
    dc:title                        "The ontology for the poliplanning application."@en ;
    dc:description                  "Conceptual model for the poliplanning app."@en ;
    dcterms:creator                 "Margherita Martorana" ;
    dcterms:created                 "2026-02-18"^^xsd:date ;
    owl:versionInfo                 "1.0.0" ;
    dc:license                      <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix   "opp";
    vann:preferredNamespaceUri      "http://example.org/poliplanning#" .


#################################################################
# Encounter
#################################################################

opp:Encounter           a owl:Class ;
    dcterms:identifier  "Encounter" ;
    rdfs:label          "Encounter"@en,
                        "Encounter"@nl ;
    rdfs:comment        "An interaction between a patient and a healthcare provider."@en,
                        "An interaction between a patient and a healthcare provider."@nl .

opp:hasDuration         a owl:DatatypeProperty ;
    dcterms:identifier  "hasDuration" ;
    rdfs:label          "has duration"@en,
                        "has duration"@nl ;
    rdfs:comment        "Duration in XSD duration format (PnYnMnDTnHnMnS, see https://www.w3.org/TR/xmlschema-2/#duration)"@en,
                        "Duration in XSD duration format (PnYnMnDTnHnMnS, see https://www.w3.org/TR/xmlschema-2/#duration)"@nl ;
    rdfs:range          xsd:duration .

opp:hasGoal             a owl:ObjectProperty ;
    dcterms:identifier  "hasGoal" ;
    rdfs:label          "has goal"@en,
                        "has goal"@nl ;
    rdfs:comment        "Relates an encounter to its goal."@en,
                        "Relates an encounter to its goal."@nl ;
    rdfs:domain         opp:Encounter ;
    rdfs:range          skos:Concept .

opp:hasMedium           a owl:ObjectProperty ;
    dcterms:identifier  "hasMedium" ;
    rdfs:label          "has medium"@en,
                        "has medium"@nl ;
    rdfs:comment        "Relates an encounter to the medium through which it takes place."@en,
                        "Relates an encounter to the medium through which it takes place."@nl ;
    rdfs:domain         opp:Encounter ;
    rdfs:range          skos:Concept .         

opp:hasPriority         a owl:ObjectProperty ;
    dcterms:identifier  "hasPriority" ;
    rdfs:label          "has priority"@en,
                        "has priority"@nl ;
    rdfs:comment        "Relates an encounter to its priority."@en,
                        "Relates an encounter to its priority."@nl ;
    rdfs:domain         opp:Encounter ;
    rdfs:range          skos:Concept .

opp:hasFunction         a owl:ObjectProperty ;
    dcterms:identifier  "hasRequiredFunction" ;
    rdfs:label          "has required function"@en,
                        "has required function"@nl ;
    rdfs:comment        "Relates an encounter to the required function."@en,
                        "Relates an encounter to the required function."@nl ;
    rdfs:domain         opp:Encounter ;
    rdfs:range          skos:Concept .

opp:hasSpecialty        a owl:ObjectProperty ;
    dcterms:identifier  "hasSpecialty" ;
    rdfs:label          "has specialty"@en,
                        "has specialty"@nl ;
    rdfs:comment        "Relates an entity to its medical specialty."@en,
                        "Relates an entity to its medical specialty."@nl ;
    rdfs:range          skos:Concept .
             

###############################################################
# Code
#################################################################

opp:Code                a owl:Class ;
    dcterms:identifier  "Code" ;
    rdfs:label          "Code"@en,
                        "Code"@nl ;
    rdfs:comment        "Represents a coded identifier."@en,
                        "Represents a coded identifier."@nl .

opp:hasCode             a owl:ObjectProperty ;
    dcterms:identifier  "hasCode" ;
    rdfs:label          "has code"@en,
                        "has code"@nl ;
    rdfs:comment        "Relates a resource to a code."@en,
                        "Relates a resource to a code."@nl ;
    rdfs:range          opp:Code .

opp:codeValue           a owl:DatatypeProperty ;
    dcterms:identifier  "codeValue" ;
    rdfs:label          "code value"@en,
                        "code value"@nl ;
    rdfs:comment        "Literal value of a code."@en,
                        "Literal value of a code."@nl ;
    rdfs:domain         opp:Code ;
    rdfs:range          xsd:string .

opp:codeSystem          a owl:ObjectProperty ;
    dcterms:identifier  "codeSystem" ;
    rdfs:label          "code system"@en,
                        "code system"@nl ;
    rdfs:comment        "Relates a code to the coding system."@en,
                        "Relates a code to the coding system."@nl ;
    rdfs:domain         opp:Code ;
    rdfs:range          skos:Concept .


#################################################################
# Resource
#################################################################

opp:Resource a owl:Class ;
    dcterms:identifier  "Resource" ;
    rdfs:label          "resource"@en,
                        "resource"@nl ;
    rdfs:comment        "A generic resource that can be used or assigned in scheduling, such as an employee, sub-agenda, room, or device."@en,
                        "Een generieke resource die gebruikt of toegewezen kan worden in planning, zoals een medewerker, subagenda, kamer of apparaat."@nl .

opp:Employee a owl:Class ;
    rdfs:subClassOf     opp:Resource ;
    dcterms:identifier  "Employee" ;
    rdfs:label          "employee"@en,
                        "medewerker"@nl ;
    rdfs:comment        "A human resource involved in appointments, such as a clinician, nurse, or assistant."@en,
                        "Een menselijke resource betrokken bij afspraken, zoals een arts, verpleegkundige of assistent."@nl .

opp:SubAgenda a owl:Class ;
    rdfs:subClassOf     opp:Resource ;
    dcterms:identifier  "SubAgenda" ;
    rdfs:label          "sub-agenda"@en,
                        "sub-agenda"@nl ;
    rdfs:comment        "Represents a sub-agenda for scheduling, typically corresponding to a specific clinic, professional, or service."@en,
                        "Representeert een subagenda voor planning, meestal gekoppeld aan een specifieke poli, professional of dienst."@nl .

opp:Patient a owl:Class ;
    rdfs:subClassOf     opp:Resource ;
    dcterms:identifier  "Patient" ;
    rdfs:label          "patient"@en,
                        "patiënt"@nl ;
    rdfs:comment        "A patient involved in an appointment or scheduling context."@en,
                        "Een patiënt betrokken bij een afspraak of planningscontext."@nl .

opp:Location            a owl:Class ;
    rdfs:subClassOf     opp:Resource ;
    dcterms:identifier  "Location" ;
    rdfs:label          "location"@en,
                        "locatie"@nl ;
    rdfs:comment        "A locational resource used in scheduling."@en,
                        "Een locatie-resource gebruikt in planning."@nl .


#################################################################
# Appointment Series Item
#################################################################

opp:AppointmentItem             a owl:Class ;
    dcterms:identifier          "AppointmentItem" ;
    rdfs:label                  "appointment item"@en,
                                "appointment item"@nl ;
    rdfs:comment                "Represents an item in an appointment series."@en,
                                "Represents an item in an appointment series."@nl .

opp:hasEncounter                a owl:ObjectProperty ;
    dcterms:identifier          "hasEncounter" ;
    rdfs:label                  "has encounter"@en,
                                "has encounter"@nl ;
    rdfs:comment                "Relates an appointment series item to an encounter."@en,
                                "Relates an appointment series item to an encounter."@nl ;
    rdfs:domain                 opp:AppointmentItem ;
    rdfs:range                  opp:Encounter .

opp:hasSchedulingPolicy         a owl:ObjectProperty ;
    dcterms:identifier          "hasSchedulingPolicy" ;
    rdfs:label                  "has scheduling policy"@en,
                                "has scheduling policy"@nl ;
    rdfs:comment                "Relates an appointment series item to a scheduling policy."@en,
                                "Relates an appointment series item to a scheduling policy."@nl ;
    rdfs:domain                 opp:AppointmentItem ;
    rdfs:range                  skos:Concept .

opp:isAppointmentItemOf         a owl:ObjectProperty ;
    dcterms:identifier          "isAppointmentItemOf" ;
    rdfs:label                  "is appointment series item of"@en,
                                "is appointment series item of"@nl ;
    rdfs:comment                "Relates an appointment series item to its appointment series."@en,
                                "Relates an appointment series item to its appointment series."@nl ;
    rdfs:domain                 opp:AppointmentItem ;
    rdfs:range                  opp:AppointmentSeries ;
    owl:inverseOf               opp:hasAppointmentItem .

opp:hasConstraint               a owl:ObjectProperty ;
    dcterms:identifier          "hasConstraint" ;
    rdfs:label                  "has constraint"@en,
                                "has constraint"@nl ;
    rdfs:comment                "Relates an appointment series to its constraints."@en,
                                "Relates an appointment series to its constraints."@nl ;
    rdfs:domain                 opp:AppointmentSeries ;
    rdfs:range                  opp:Constraint ;
    owl:inverseOf               opp:isConstraintOf .

#################################################################
# Appointment Series
#################################################################

opp:AppointmentSeries           a owl:Class ;
    dcterms:identifier          "AppointmentSeries" ;
    rdfs:label                  "appointment series"@en,
                                "appointment series"@nl ;
    rdfs:comment                "Represents a series of appointment items."@en,
                                "Represents a series of appointment items."@nl .

opp:hasRequiredPlanHorizon      a owl:ObjectProperty ;
    dcterms:identifier          "hasRequiredPlanHorizon" ;
    rdfs:label                  "has required plan horizon"@en,
                                "has required plan horizon"@nl ;
    rdfs:comment                "Relates an appointment series to its required plan horizon."@en,
                                "Relates an appointment series to its required plan horizon."@nl ;
    rdfs:domain                 opp:AppointmentSeries ;
    rdfs:range                  skos:Concept .

opp:hasAppointmentItem          a owl:ObjectProperty ;
    dcterms:identifier          "hasAppointmentItem" ;
    rdfs:label                  "has appointment series item"@en,
                                "has appointment series item"@nl ;
    rdfs:comment                "Relates an appointment series to its appointment series items."@en,
                                "Relates an appointment series to its appointment series items."@nl ;
    rdfs:domain                 opp:AppointmentSeries ;
    rdfs:range                  opp:AppointmentItem ;
    owl:inverseOf               opp:isAppointmentItemOf .


#################################################################
# Constraint
#################################################################

opp:Constraint                  a owl:Class ;
    dcterms:identifier          "Constraint" ;
    rdfs:label                  "constraint"@en,
                                "constraint"@nl ;
    rdfs:comment                "Represents a scheduling constraint."@en,
                                "Represents a scheduling constraint."@nl ;
    rdfs:subClassOf 
        [   a owl:Restriction ;
            owl:onProperty      opp:inSeries ;
            owl:minCardinality  "1"^^xsd:nonNegativeInteger ],
        [   a owl:Restriction ;
            owl:onProperty      opp:appliesToItem ;
            owl:minCardinality  "1"^^xsd:nonNegativeInteger  ] .

opp:TimeConstraint              a owl:Class ;
    dcterms:identifier          "TimeConstraint" ;
    rdfs:label                  "time constraint"@en,
                                "time constraint"@nl ;
    rdfs:comment                "Constraint related to time."@en,
                                "Constraint related to time."@nl ;
    rdfs:subClassOf             opp:Constraint,
        [   a owl:Restriction ;
            owl:onProperty      opp:lhsExpression ;
            owl:cardinality     "1"^^xsd:nonNegativeInteger ],
        [   a owl:Restriction ;
            owl:onProperty      opp:rhsExpression ;
            owl:cardinality     "1"^^xsd:nonNegativeInteger ],
        [   a owl:Restriction ;
            owl:onProperty      opp:hasOperator ;
            owl:cardinality     "1"^^xsd:nonNegativeInteger ] .

opp:ResourceConstraint          a owl:Class ;
    dcterms:identifier          "ResourceConstraint" ;
    rdfs:label                  "resource constraint"@en,
                                "resource constraint"@nl ;
    rdfs:comment                "Constraint related to resources."@en,
                                "Constraint related to resources."@nl ;
    rdfs:subClassOf             opp:Constraint ,
        [   a owl:Restriction ;
            owl:onProperty      opp:resourceExpression ;
            owl:cardinality     "1"^^xsd:nonNegativeInteger ],
        [   a owl:Restriction ;
            owl:onProperty      opp:hasOperator ;
            owl:cardinality     "1"^^xsd:nonNegativeInteger ] .

opp:RelativeTimeConstraint      a owl:Class ;
    dcterms:identifier          "RelativeTimeConstraint" ;
    rdfs:label                  "relative time constraint"@en,
                                "relative time constraint"@nl ;
    rdfs:comment                "Constraint on relative time between items."@en,
                                "Constraint on relative time between items."@nl ;
    rdfs:subClassOf             opp:TimeConstraint .

opp:AbsoluteTimeConstraint      a owl:Class ;
    dcterms:identifier          "AbsoluteTimeConstraint" ;
    rdfs:label                  "absolute time constraint"@en,
                                "absolute time constraint"@nl ;
    rdfs:comment                "Constraint on absolute time of items."@en,
                                "Constraint on absolute time of items."@nl ;
    rdfs:subClassOf             opp:TimeConstraint .

opp:RelativeResourceConstraint  a owl:Class ;
    dcterms:identifier          "RelativeResourceConstraint" ;
    rdfs:label                  "relative resource constraint"@en,
                                "relative resource constraint"@nl ;
    rdfs:comment                "Constraint on resources between items."@en,
                                "Constraint on resources between items."@nl ;
    rdfs:subClassOf             opp:ResourceConstraint .

opp:AbsoluteResourceConstraint  a owl:Class ;
    dcterms:identifier          "AbsoluteResourceConstraint" ;
    rdfs:label                  "absolute resource constraint"@en,
                                "absolute resource constraint"@nl ;
    rdfs:comment                "Constraint on specific resources for items."@en,
                                "Constraint on specific resources for items."@nl ;
    rdfs:subClassOf             opp:ResourceConstraint .

opp:hasDateTimeFormat           a owl:ObjectProperty ;
    dcterms:identifier          "hasDateTimeFormat" ;
    rdfs:label                  "has date time format"@en,
                                "has date time format"@nl ;
    rdfs:comment                "Relates a constraint to a date time format."@en,
                                "Relates a constraint to a date time format."@nl ;
    rdfs:domain                 opp:Constraint ;
    rdfs:range                  skos:Concept .

opp:hasOperator                 a owl:ObjectProperty ;
    dcterms:identifier          "hasOperator" ;
    rdfs:label                  "has operator"@en,
                                "has operator"@nl ;
    rdfs:comment                "Relates a constraint to its operator."@en,
                                "Relates a constraint to its operator."@nl ;
    rdfs:domain                 opp:Constraint ;
    rdfs:range                  opp:Operator .

opp:lhsExpression               a owl:ObjectProperty ;
    dcterms:identifier          "lhsExpression" ;
    rdfs:label                  "left-hand expression"@en,
                                "left-hand expression"@nl ;
    rdfs:comment                "Relates a constraint to its left-hand expression."@en,
                                "Relates a constraint to its left-hand expression."@nl ;
    rdfs:domain                 opp:TimeConstraint ;
    rdfs:range                  opp:TimeExpression .

opp:rhsExpression               a owl:ObjectProperty ;
    dcterms:identifier          "rhsExpression" ;
    rdfs:label                  "right-hand expression"@en,
                                "right-hand expression"@nl ;
    rdfs:comment                "Relates a constraint to its right-hand expression."@en,
                                "Relates a constraint to its right-hand expression."@nl ;
    rdfs:domain                 opp:TimeConstraint ;
    rdfs:range                  opp:TimeExpression .

opp:resourceExpression          a owl:ObjectProperty ;
    dcterms:identifier          "resourceExpression" ;
    rdfs:label                  "resource expression"@en,
                                "resource expression"@nl ;
    rdfs:comment                "Relates a constraint to its resource expression."@en,
                                "Relates a constraint to its resource expression."@nl ;
    rdfs:domain                 opp:ResourceConstraint ;
    rdfs:range                  opp:ResourceExpression .

opp:isConstraintOf              a owl:ObjectProperty ;
    dcterms:identifier          "isConstraintOf" ;
    rdfs:label                  "is constraint of"@en,
                                "is constraint of"@nl ;
    rdfs:comment                "Relates a constraint to an appointment series."@en,
                                "Relates a constraint to an appointment series."@nl ;
    owl:inverseOf               opp:hasConstraint .

opp:appliesToItem               a owl:ObjectProperty ;
    dcterms:identifier          "appliesToItem" ;
    rdfs:label                  "applies to item"@en,
                                "applies to item"@nl ;
    rdfs:comment                "Relates a constraint to the appointment series items it applies to."@en,
                                "Relates a constraint to the appointment series items it applies to."@nl .


#################################################################
# Operator
#################################################################

opp:Operator                    a owl:Class ;
    dcterms:identifier          "Operator" ;
    rdfs:label                  "operator"@en,
                                "operator"@nl ;
    rdfs:comment                "Represents an operator."@en,
                                "Represents an operator."@nl .

opp:LogicalOperator             a owl:Class ;
    dcterms:identifier          "LogicalOperator" ;
    rdfs:subClassOf             opp:Operator ;
    owl:disjointWith            opp:RelationalOperator ;
    rdfs:label                  "logical operator"@en,
                                "logical operator"@nl ;
    rdfs:comment                "Combines conditions."@en,
                                "Combines conditions."@nl .

opp:RelationalOperator          a owl:Class ;
    dcterms:identifier          "RelationalOperator" ;
    rdfs:subClassOf             opp:Operator ;
    rdfs:label                  "relational operator"@en,
                                "relational operator"@nl ;
    rdfs:comment                "Compares two expressions."@en,
                                "Compares two expressions."@nl .

opp:EqualityOperator            a owl:Class ;
    dcterms:identifier          "EqualityOperator" ;
    rdfs:subClassOf             opp:RelationalOperator ;
    rdfs:label                  "equality operator"@en,
                                "equality operator"@nl ;
    rdfs:comment                "Checks equality between values."@en,
                                "Checks equality between values."@nl .

opp:hasOperatorFunction         a owl:DatatypeProperty ;
    dcterms:identifier          "hasOperatorFunction" ;
    rdfs:label                  "has operator function"@en,
                                "has operator function"@nl ;
    rdfs:comment                "Symbol of the operator."@en,
                                "Symbol of the operator."@nl ;
    rdfs:domain                 opp:Operator ;
    rdfs:range                  xsd:string .

# Logical operators
opp:Operator_AND                a opp:LogicalOperator ;
    dcterms:identifier          "AND" ;
    rdfs:label                  "and"@en,
                                "and"@nl ;
    rdfs:comment                "A statement with this operator is true when both of its operand expressions are true"@en,
                                "A statement with this operator is true when both of its operand expressions are true"@nl ;
    opp:hasOperatorFunction     "AND" .

opp:Operator_OR                 a opp:LogicalOperator ;
    dcterms:identifier          "OR" ;
    rdfs:label                  "or"@en,
                                "or"@nl ;
    rdfs:comment                "A statement with this operator is true when at least one of its operand expressions is true"@en,
                                "A statement with this operator is true when at least one of its operand expressions is true"@nl ;
    opp:hasOperatorFunction     "OR" .

opp:Operator_NOT                a opp:LogicalOperator ;
    dcterms:identifier          "NOT" ;
    rdfs:label                  "not"@en,
                                "not"@nl ;
    rdfs:comment                "A statement with this operator is true when the given operand results to false (and vice-versa)"@en,
                                "A statement with this operator is true when the given operand results to false (and vice-versa)"@nl ;
    opp:hasOperatorFunction     "NOT" .

# Relational operators
opp:Operator_Greater            a opp:RelationalOperator ;
    dcterms:identifier          "Greater" ;
    rdfs:label                  "greater"@en,
                                "greater"@nl ;
    rdfs:comment                "Greater than."@en,
                                "Greater than."@nl ;
    opp:hasOperatorFunction     ">" .

opp:Operator_GreaterOrEqual     a opp:RelationalOperator ;
    dcterms:identifier          "GreaterOrEqual" ;
    rdfs:label                  "greater or equal"@en,
                                "greater or equal"@nl ;
    rdfs:comment                "Greater than or equal."@en,
                                "Greater than or equal."@nl ;
    opp:hasOperatorFunction     ">=" .

opp:Operator_Less               a opp:RelationalOperator ;
    dcterms:identifier          "Less" ;
    rdfs:label                  "less"@en,
                                "less"@nl ;
    rdfs:comment                "Less than."@en,
                                "Less than."@nl ;
    opp:hasOperatorFunction     "<" .

opp:Operator_LessOrEqual        a opp:RelationalOperator ;
    dcterms:identifier          "LessOrEqual" ;
    rdfs:label                  "less or equal"@en,
                                "less or equal"@nl ;
    rdfs:comment                "Less than or equal."@en,
                                "Less than or equal."@nl ;
    opp:hasOperatorFunction     "<=" .

opp:Operator_Range              a opp:RelationalOperator ;
    dcterms:identifier          "Range" ;
    rdfs:label                  "range"@en,
                                "range"@nl ;
    rdfs:comment                "The constrained time must fall between the left-hand and right-hand boundary expressions."@en,
                                "The constrained time must fall between the left-hand and right-hand boundary expressions."@nl ;
    opp:hasOperatorFunction     "RANGE" .

# Equality operators
opp:Operator_Equal              a opp:EqualityOperator ;
    dcterms:identifier          "Equal" ;
    rdfs:label                  "equal"@en,
                                "equal"@nl ;
    rdfs:comment                "Equal to."@en,
                                "Equal to."@nl ;
    opp:hasOperatorFunction     "==" .

opp:Operator_NotEqual           a opp:EqualityOperator ;
    dcterms:identifier          "NotEqual" ;
    rdfs:label                  "not equal"@en,
                                "not equal"@nl ;
    rdfs:comment                "Not equal to."@en,
                                "Not equal to."@nl ;
    opp:hasOperatorFunction     "!=" .


#################################################################
# Time expression and Point
#################################################################

opp:TimeExpression      a owl:Class ;
    dcterms:identifier  "TimeExpression" ;
    rdfs:label          "time expression"@en,
                        "time expression"@nl ;
    rdfs:comment        "Represents a time expression."@en,
                        "Represents a time expression."@nl ;
    rdfs:subClassOf
        [   a owl:Restriction ;
            owl:onProperty      opp:basePoint ;
            owl:cardinality     "1"^^xsd:nonNegativeIntege  ],
        [   a owl:Restriction ;
            owl:onProperty      opp:offset ;
            owl:maxCardinality  "1"^^xsd:nonNegativeInteger ] .

opp:TimePoint           a owl:Class ;
    dcterms:identifier  "TimePoint" ;
    rdfs:label          "time point"@en,
                        "time point"@nl ;
    rdfs:comment        "Represents a time point."@en,
                        "Represents a time point."@nl .

opp:basePoint           a owl:ObjectProperty ;
    dcterms:identifier  "basePoint" ;
    rdfs:label          "base point"@en,
                        "base point"@nl ;
    rdfs:comment        "Relates a time expression to its base point."@en,
                        "Relates a time expression to its base point."@nl ;
    rdfs:domain         opp:TimeExpression ;
    rdfs:range          opp:TimePoint .

opp:offset              a owl:DatatypeProperty ;
    dcterms:identifier  "offset" ;
    rdfs:label          "offset"@en,
                        "offset"@nl ;
    rdfs:comment        "Offset in XSD duration format."@en,
                        "Offset in XSD duration format."@nl ;
    rdfs:domain         opp:TimeExpression ;
    rdfs:range          xsd:duration .

opp:timeValue           a owl:DatatypeProperty ;
    dcterms:identifier  "timeValue" ;
    rdfs:label          "time value"@en,
                        "time value"@nl ;
    rdfs:comment        "Literal value of a time point."@en,
                        "Literal value of a time point."@nl ;
    rdfs:domain         opp:TimePoint ;
    rdfs:range          xsd:time .

opp:intervalStart       a owl:ObjectProperty ;
    dcterms:identifier  "intervalStart" ;
    rdfs:label          "interval start"@en,
                        "interval start"@nl ;
    rdfs:comment        "Relates a time point to the interval start of an appointment series item."@en,
                        "Relates a time point to the interval start of an appointment series item."@nl ;
    rdfs:domain         opp:TimePoint ;
    rdfs:range          opp:AppointmentItem .

opp:intervalEnd         a owl:ObjectProperty ;
    dcterms:identifier  "intervalEnd" ;
    rdfs:label          "interval end"@en,
                        "interval end"@nl ;
    rdfs:comment        "Relates a time point to the interval end of an appointment series item."@en,
                        "Relates a time point to the interval end of an appointment series item."@nl ;
    rdfs:domain         opp:TimePoint ;
    rdfs:range          opp:AppointmentItem .


#################################################################
# Resource expression
#################################################################

opp:ResourceExpression  a owl:Class ;
    dcterms:identifier  "ResourceExpression" ;
    rdfs:label          "resource expression"@en,
                        "resource expression"@nl ;
    rdfs:comment        "Represents an expression over one or more resources or resource classes."@en,
                        "Represents an expression over one or more resources or resource classes."@nl ;
    rdfs:subClassOf
        [   a owl:Restriction ;
            owl:onProperty      opp:resource ;
            owl:minCardinality  "1"^^xsd:nonNegativeInteger ] .

opp:resource            a owl:ObjectProperty ;
    dcterms:identifier  "resource" ;
    rdfs:label          "has resource"@en,
                        "has resource"@nl ;
    rdfs:comment        "Links a resource expression to its resources."@en,
                        "Links a resource expression to its resources."@nl ;
    rdfs:domain         opp:ResourceExpression ;
    rdfs:range          opp:Resource .


#################################################################
# Location
#################################################################

opp:Building            a owl:Class ;
    rdfs:subClassOf     opp:Location ;
    dcterms:identifier  "Building" ;
    rdfs:label          "building"@en,
                        "gebouw"@nl ;
    rdfs:comment        "A building location."@en,
                        "Een gebouwlocatie."@nl .      

opp:Division            a owl:Class ;
    rdfs:subClassOf     opp:Location ;
    dcterms:identifier  "Division" ;
    rdfs:label          "division"@en,
                        "divisie"@nl ;
    rdfs:comment        "A division location."@en,
                        "Een divisielocatie."@nl .

opp:Room                a owl:Class ;
    rdfs:subClassOf     opp:Location ;
    dcterms:identifier  "Room" ;
    rdfs:label          "room"@en,
                        "kamer"@nl ;
    rdfs:comment        "A room location."@en,
                        "Een kamerlocatie."@nl .

opp:Unit                a owl:Class ;
    rdfs:subClassOf     opp:Location ;
    dcterms:identifier  "Unit" ;
    rdfs:label          "unit"@en,
                        "unit"@nl ;
    rdfs:comment        "A lowest-level location such as a bed or chair."@en,
                        "Een laagste locatielaag zoals een bed of stoel."@nl .

opp:hasParentLocation   a owl:ObjectProperty ;
    dcterms:identifier  "hasParentLocation" ;
    rdfs:label          "has parent location"@en,
                        "heeft bovenliggende locatie"@nl ;
    rdfs:comment        "Links a location to its parent location."@en,
                        "Koppelt een locatie aan de bovenliggende locatie."@nl ;
    rdfs:domain         opp:Location ;
    rdfs:range          opp:Location ;
    owl:inverseOf       opp:hasChildLocation .

opp:hasChildLocation    a owl:ObjectProperty ;
    dcterms:identifier  "hasChildLocation" ;
    rdfs:label          "has child location"@en,
                        "heeft onderliggende locatie"@nl ;
    rdfs:comment        "Links a location to a child location."@en,
                        "Koppelt een locatie aan een onderliggende locatie."@nl ;
    rdfs:domain         opp:Location ;
    rdfs:range          opp:Location .

opp:capacity            a owl:DatatypeProperty ;
    dcterms:identifier  "capacity" ;
    rdfs:label          "capacity"@en,
                        "capaciteit"@nl ;
    rdfs:comment        "The capacity of a location."@en,
                        "De capaciteit van een locatie."@nl ;
    rdfs:domain         opp:Location ;
    rdfs:range          xsd:integer .
