device:CardiacMonitor_Hemosphere_Edwards a skos:Concept ;
    mda:hasDeviceType deviceType:Hemosphere ;
    mda:hasManufacturer manufacturer:Edwards ;
    rdfs:subClassOf device:CardiacMonitor ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( device:CardiacMonitor [ a owl:Restriction ;
                        owl:hasValue deviceType:Hemosphere ;
                        owl:onProperty mda:hasDeviceType ] [ a owl:Restriction ;
                        owl:hasValue manufacturer:Edwards ;
                        owl:onProperty mda:hasManufacturer ] ) ] ;
    skos:broader device:CardiacMonitor ;
    skos:inScheme device:Scheme ;
    skos:notation "CardiacMonitor_Hemosphere_Edwards" ;
    skos:prefLabel "Cardiac Monitor_Hemosphere_Edwards"@en .

