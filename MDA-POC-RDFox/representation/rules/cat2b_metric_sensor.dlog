####################################################################
# cat2b_metric_sensor.dlog — HAND-AUTHORED. NOT GENERATED.
#
# NL rule (CAT2, "simultaneous alarms likely carrying overlapping or
# redundant information"): "If an alarm conveys the same metric via a
# different sensor, an incoming alarm conveying that metric from another
# sensor can be silenced."
#
# Clause by clause (decisions agreed 2026-09-21):
#   "an incoming alarm"        — a PHYSIOLOGICAL alarm, at its arrival.
#   "an alarm" (active)        — a physiological alarm of the same patient
#                                whose transient graph is valid now, other
#                                than the incoming one.
#   "the same metric"          — the same metric type, exactly (heart rate
#                                is not pulse rate, systolic ABP is not MAP;
#                                related metrics are CAT2a's business).
#   "via a different sensor"   — a different functional unit, or a
#                                different sensor type. Not the sensor IRI:
#                                sensor refinements (anatomical position)
#                                come only from technical alarms ("Storing
#                                in SpO2", "ART buiten bereik laag", "ART
#                                statische druk") and split ONE physical
#                                sensor into two identities depending on
#                                arrival order. No physiological alarm
#                                carries a refinement, so two same-type
#                                sensors on one functional unit (e.g. pre-
#                                and post-ductal SpO2) cannot be told apart
#                                in this catalogue anyway.
#   "overlapping or redundant" — (from the category header, as CAT2a) the
#                                incoming alarm deviates in the SAME
#                                direction and is NOT MORE SEVERE
#                                (metric_state_order.ttl): two sensors that
#                                disagree (SpO2 low vs high) or an escalation
#                                (low SpO2 -> desaturation) is information.
#                                No priority condition — the NL rule has
#                                none. The NL rule should read "...via a
#                                different sensor, deviating in the same
#                                direction and not more severely, ...".
#   "can be silenced"          — for as long as an alarm that justified it
#                                at arrival is still active, shared with
#                                CAT2a: one silence per alarm, lifted when
#                                the last alarm justifying it under EITHER
#                                rule ends (replay_driver.py's
#                                cat2_silence_insert / cat2_lift; logged as
#                                cat2_lifted).
#
# REPORTED STATE. As CAT2a: the metric state is matched inside each alarm's
# own graph, which relies on no alarm editing another's graph.
#
# GRAPHS. ?gT/?gA: the incoming/active alarm's transient graph. ?gP/?gAP: a
# persistent copy of its sensor chain, anchored on its own analysis, so the
# sensor is the one that produced its metric.
#
# NOT LOADED AS A STANDING RULE. It runs as a one-shot `select` (and the
# silence INSERT) at each alarm's arrival, hand-translated into
# engine/replay_driver.py's _ONDEMAND_BODY_TEMPLATES["cat2b"]. It replaces
# the standing sensor count (shadow/cat2b_sensor_count_aggregate.dlog, no
# longer loaded): the redundancy test compares direction and severity of
# ONE active alarm at once, which a per-key count cannot express. Keep the
# two in sync by hand; the cat2b_* fixtures check both.
####################################################################

@prefix mda:              <https://w3id.org/mda/ontology#> .
@prefix mdapoc:           <https://w3id.org/mda/poc#> .
@prefix alarmcat:         <https://w3id.org/mda/vocab/alarm-category/> .

[?alarm, mdapoc:silencedBy, ?active] ?gT :-
    # the incoming alarm (its own graphs)
    [?alarm, mda:hasCategory, alarmcat:Physiological] ?gT,
    [?alarm, mda:hasMessage, ?msg] ?gT,
    [?msg, mda:concernsPatient, ?patient] ?gT,
    [?msg, mda:triggeredBy, ?fu] ?gT,
    [?analysis, mda:producesMetric, ?metric] ?gT,
    [?metric, rdf:type, ?metricType] ?gT,
    [?metric, ?stateProp, ?state] ?gT,
    FILTER(?stateProp IN (mda:hasValueState, mda:hasRhythm)),
    [?fu, mda:hasSensor, ?sensor] ?gP,
    [?sensor, mda:sensorProducesSignal, ?signal] ?gP,
    [?signal, mda:analyzedBy, ?analysis] ?gP,
    [?sensor, rdf:type, ?sensorType] ?gP,
    [?state, mdapoc:deviationDirection, ?direction],
    [?state, mdapoc:deviationSeverity, ?severity],
    # an active alarm of the same patient, same metric type (its own graphs)
    [?active, mda:hasCategory, alarmcat:Physiological] ?gA,
    [?active, mda:hasMessage, ?activeMsg] ?gA,
    [?activeMsg, mda:concernsPatient, ?patient] ?gA,
    [?activeMsg, mda:triggeredBy, ?activeFu] ?gA,
    [?activeAnalysis, mda:producesMetric, ?activeMetric] ?gA,
    [?activeMetric, rdf:type, ?metricType] ?gA,
    [?activeMetric, ?activeStateProp, ?activeState] ?gA,
    FILTER(?activeStateProp IN (mda:hasValueState, mda:hasRhythm)),
    [?activeFu, mda:hasSensor, ?activeSensor] ?gAP,
    [?activeSensor, mda:sensorProducesSignal, ?activeSignal] ?gAP,
    [?activeSignal, mda:analyzedBy, ?activeAnalysis] ?gAP,
    [?activeSensor, rdf:type, ?activeSensorType] ?gAP,
    [?activeState, mdapoc:deviationDirection, ?direction],
    [?activeState, mdapoc:deviationSeverity, ?activeSeverity],
    FILTER(?active != ?alarm),
    FILTER(?activeSeverity >= ?severity),
    # a different sensor: another functional unit, or another sensor type
    FILTER(?activeFu != ?fu || ?activeSensorType != ?sensorType) .

# VALIDATION — engine/replay_driver.py run(), fixtures in
# DATA/CAT_evaluation/events_data.csv: cat2b_pos (low SpO2 on two monitors)
# silences; cat2b_neg, cat2b_opposite and cat2b_escalation do not;
# cat2b_same_sensor never fires CAT2b (forbidden firing); cat2b_lift and
# cat3f are silenced and lifted when the justifying alarm ends.
