alarmtype:CardiohelpPvenOnderWaarschuwingsgrens_Unknown a mda:AlarmType ;
    mda:hasCategory alarmcat:Physiological ;
    mda:hasLabel "CARDIOHELP - pVen onder waarschuwingsgrens"@en ;
    mda:hasLabelConcept <https://w3id.org/mda/vocab/alarm-label/CardiohelpPvenOnderWaarschuwingsgrens> ;
    mda:hasMessage [ a mda:AlarmMessage ;
            mda:concernsPatient [ a mda:Patient ] ;
            mda:triggeredBy [ a device:ExtracorporealMembraneOxygenator ;
                    mda:hasDeviceType deviceType:CardioHelp ;
                    mda:hasFunctionalUnit [ a functionalUnit:FU_InvasiveBloodPressure ;
                            mda:hasSensor [ a sensor:VenousPressureTransducer ;
                                    mda:sensorProducesSignal [ a signal:Pressure_waveform ;
                                            mda:analyzedBy [ a <https://w3id.org/mda/vocab/signal-analysis/VenousPressureAnalysis> ;
                                                    mda:producesMetric [ a metric:VenousPressure ;
                                                            mda:hasRate metricRate:Decreased ] ] ] ] ] ;
                    mda:hasManufacturer manufacturer:Getinge ] ] ;
    mda:hasPriority alarmprio:Unknown .

