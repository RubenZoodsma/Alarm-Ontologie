####################################################################
# clinical_vocab.ttl — HAND-AUTHORED.  NOT GENERATED.  DO NOT OVERWRITE.
#
# The clinical universals: physiological properties and processes, organs,
# and organ systems.  These are definitional — true of the domain, not of
# any alarm and not of any patient.
#
# WHY THIS LIVES IN 2_READOUT RATHER THAN 1_BASE
# ----------------------------------------------
# The knowledge itself is base knowledge.  Its *extent* is not: we only know
# which clinical vocabulary the model needs once the alarm catalogue tells us
# which metrics are in play.  So this is a stage-2 human enrichment — authored
# by hand, but scoped by what stage 2 revealed.
#
# It is the first authored file in 2_READOUT.  The rule that "generated files
# in 2_READOUT are disposable" does NOT apply to it or to clinical_axioms.ttl.
# vocab_readout.py must never write to either.
#
# TRANSITIONAL OVERLAP
# --------------------
# Several of these concepts are currently ALSO emitted into vocab_generated.ttl,
# because data.csv still carries the PhysiologicalProperty / PhysiologicalProcess
# / Organ / OrganSystem columns.  When those columns are removed from data.csv,
# the generated copies disappear and this file becomes their sole home.  Until
# then the duplication is harmless (identical IRIs, union semantics) but the
# authored labels and definitions here are the better ones — the generated stubs
# carry English text in the @nl slot as a placeholder.
####################################################################

@prefix mda:        <https://w3id.org/mda/ontology/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .

@prefix physiologicalProperty: <https://w3id.org/mda/vocab/physiological-property/> .
@prefix physiologicalProcess:  <https://w3id.org/mda/vocab/physiological-process/> .
@prefix organ:       <https://w3id.org/mda/vocab/organ/> .
@prefix organSystem: <https://w3id.org/mda/vocab/organ-system/> .


####################################################################
# Organ systems
####################################################################

organSystem:CardioVascular a skos:Concept ;
    skos:inScheme       organSystem:Scheme ;
    skos:broader        organSystem:OrganSystem ;
    rdfs:subClassOf     mda:OrganSystem ;
    skos:prefLabel      "Cardiovascular system"@en, "Cardiovasculair systeem"@nl ;
    skos:definition     "The heart and the blood vessels, which together circulate blood through the body."@en,
                        "Het hart en de bloedvaten, die samen het bloed door het lichaam circuleren."@nl ;
    skos:notation       "CardioVascular" .

organSystem:Pulmonary a skos:Concept ;
    skos:inScheme       organSystem:Scheme ;
    skos:broader        organSystem:OrganSystem ;
    rdfs:subClassOf     mda:OrganSystem ;
    skos:prefLabel      "Pulmonary system"@en, "Pulmonaal systeem"@nl ;
    skos:definition     "The airways and lungs, responsible for ventilation and gas exchange."@en,
                        "De luchtwegen en longen, verantwoordelijk voor ventilatie en gaswisseling."@nl ;
    skos:notation       "Pulmonary" .

organSystem:Endocrine a skos:Concept ;
    skos:inScheme       organSystem:Scheme ;
    skos:broader        organSystem:OrganSystem ;
    rdfs:subClassOf     mda:OrganSystem ;
    skos:prefLabel      "Endocrine system"@en, "Endocrien systeem"@nl ;
    skos:definition     "The glands and signalling pathways that regulate metabolism, growth and homeostasis."@en,
                        "De klieren en signaalwegen die metabolisme, groei en homeostase reguleren."@nl ;
    skos:notation       "Endocrine" .


####################################################################
# Organs
####################################################################

organ:Lungs a skos:Concept ;
    skos:inScheme       organ:Scheme ;
    skos:broader        organ:Organ ;
    rdfs:subClassOf     mda:Organ ;
    skos:prefLabel      "Lungs"@en, "Longen"@nl ;
    skos:definition     "The paired respiratory organs in which gas exchange between air and blood takes place."@en,
                        "De gepaarde ademhalingsorganen waarin gaswisseling tussen lucht en bloed plaatsvindt."@nl ;
    skos:notation       "Lungs" .

organ:Heart a skos:Concept ;
    skos:inScheme       organ:Scheme ;
    skos:broader        organ:Organ ;
    rdfs:subClassOf     mda:Organ ;
    skos:prefLabel      "Heart"@en, "Hart"@nl ;
    skos:definition     "The muscular organ that pumps blood through the circulatory system."@en,
                        "Het spierorgaan dat bloed door de bloedsomloop pompt."@nl ;
    skos:notation       "Heart" .

# REVIEW — introduced to give VascularCompliance an anatomical locus.  Whether
# the arterial vasculature should be modelled as an mda:Organ, or whether the
# ontology needs a broader anatomical-structure notion, is a domain decision.
# See the note at the end of clinical_axioms.ttl.
organ:Arteries a skos:Concept ;
    skos:inScheme       organ:Scheme ;
    skos:broader        organ:Organ ;
    rdfs:subClassOf     mda:Organ ;
    skos:prefLabel      "Arteries"@en, "Arteriën"@nl ;
    skos:definition     "The systemic arterial vessels, whose wall properties determine arterial compliance and pressure."@en,
                        "De systemische arteriële vaten, waarvan de wandeigenschappen de arteriële compliantie en druk bepalen."@nl ;
    skos:notation       "Arteries" .


####################################################################
# Physiological processes
####################################################################

physiologicalProcess:Ventilation a skos:Concept ;
    skos:inScheme       physiologicalProcess:Scheme ;
    skos:broader        physiologicalProcess:PhysiologicalProcess ;
    rdfs:subClassOf     mda:PhysiologicalProcess ;
    skos:prefLabel      "Ventilation"@en, "Ventilatie"@nl ;
    skos:definition     "The movement of air into and out of the lungs."@en,
                        "De verplaatsing van lucht in en uit de longen."@nl ;
    skos:notation       "Ventilation" .

physiologicalProcess:Oxygenation a skos:Concept ;
    skos:inScheme       physiologicalProcess:Scheme ;
    skos:broader        physiologicalProcess:PhysiologicalProcess ;
    rdfs:subClassOf     mda:PhysiologicalProcess ;
    skos:prefLabel      "Oxygenation"@en, "Oxygenatie"@nl ;
    skos:definition     "The uptake of oxygen from the alveoli into the blood."@en,
                        "De opname van zuurstof vanuit de alveoli in het bloed."@nl ;
    skos:notation       "Oxygenation" .

physiologicalProcess:CardiacContraction a skos:Concept ;
    skos:inScheme       physiologicalProcess:Scheme ;
    skos:broader        physiologicalProcess:PhysiologicalProcess ;
    rdfs:subClassOf     mda:PhysiologicalProcess ;
    skos:prefLabel      "Cardiac contraction"@en, "Hartcontractie"@nl ;
    skos:definition     "The rhythmic contraction of the cardiac muscle that drives circulation."@en,
                        "De ritmische samentrekking van de hartspier die de circulatie aandrijft."@nl ;
    skos:notation       "CardiacContraction" .

physiologicalProcess:VascularCompliance a skos:Concept ;
    skos:inScheme       physiologicalProcess:Scheme ;
    skos:broader        physiologicalProcess:PhysiologicalProcess ;
    rdfs:subClassOf     mda:PhysiologicalProcess ;
    skos:prefLabel      "Vascular compliance"@en, "Vasculaire compliantie"@nl ;
    skos:definition     "The capacity of the vessel wall to distend in response to pressure, governing arterial pressure."@en,
                        "Het vermogen van de vaatwand om uit te zetten onder druk, bepalend voor de arteriële druk."@nl ;
    skos:notation       "VascularCompliance" .

physiologicalProcess:Metabolism a skos:Concept ;
    skos:inScheme       physiologicalProcess:Scheme ;
    skos:broader        physiologicalProcess:PhysiologicalProcess ;
    rdfs:subClassOf     mda:PhysiologicalProcess ;
    skos:prefLabel      "Metabolism"@en, "Metabolisme"@nl ;
    skos:definition     "The set of energy-converting reactions sustaining the organism, of which heat production is a correlate."@en,
                        "Het geheel van energie-omzettende reacties die het organisme in stand houden, waarvan warmteproductie een correlaat is."@nl ;
    skos:notation       "Metabolism" .


####################################################################
# Physiological properties
####################################################################

physiologicalProperty:PaO2 a skos:Concept ;
    skos:inScheme       physiologicalProperty:Scheme ;
    skos:broader        physiologicalProperty:PhysiologicalProperty ;
    rdfs:subClassOf     mda:PhysiologicalProperty ;
    skos:prefLabel      "Arterial oxygen tension"@en, "Arteriële zuurstofspanning"@nl ;
    skos:definition     "The partial pressure of oxygen in arterial blood."@en,
                        "De partiële zuurstofdruk in arterieel bloed."@nl ;
    skos:notation       "PaO2" .

physiologicalProperty:AirwayPressure a skos:Concept ;
    skos:inScheme       physiologicalProperty:Scheme ;
    skos:broader        physiologicalProperty:PhysiologicalProperty ;
    rdfs:subClassOf     mda:PhysiologicalProperty ;
    skos:prefLabel      "Airway pressure"@en, "Luchtwegdruk"@nl ;
    skos:definition     "The pressure within the airways during the respiratory cycle."@en,
                        "De druk in de luchtwegen gedurende de ademhalingscyclus."@nl ;
    skos:notation       "AirwayPressure" .

physiologicalProperty:ArterialPressure a skos:Concept ;
    skos:inScheme       physiologicalProperty:Scheme ;
    skos:broader        physiologicalProperty:PhysiologicalProperty ;
    rdfs:subClassOf     mda:PhysiologicalProperty ;
    skos:prefLabel      "Arterial pressure"@en, "Arteriële druk"@nl ;
    skos:definition     "The blood pressure within the systemic arteries."@en,
                        "De bloeddruk in de systemische arteriën."@nl ;
    skos:notation       "ArterialPressure" .

physiologicalProperty:ElectricalContraction a skos:Concept ;
    skos:inScheme       physiologicalProperty:Scheme ;
    skos:broader        physiologicalProperty:PhysiologicalProperty ;
    rdfs:subClassOf     mda:PhysiologicalProperty ;
    skos:prefLabel      "Cardiac electrical activity"@en, "Elektrische hartactiviteit"@nl ;
    skos:definition     "The electrical depolarisation accompanying cardiac contraction, as observed on the ECG."@en,
                        "De elektrische depolarisatie die de hartcontractie begeleidt, zoals waargenomen op het ECG."@nl ;
    skos:notation       "ElectricalContraction" .

physiologicalProperty:Respiration a skos:Concept ;
    skos:inScheme       physiologicalProperty:Scheme ;
    skos:broader        physiologicalProperty:PhysiologicalProperty ;
    rdfs:subClassOf     mda:PhysiologicalProperty ;
    skos:prefLabel      "Respiratory activity"@en, "Ademhalingsactiviteit"@nl ;
    skos:definition     "The cyclical respiratory effort, of which respiratory rate is a measure."@en,
                        "De cyclische ademhalingsinspanning, waarvan de ademfrequentie een maat is."@nl ;
    skos:notation       "Respiration" .

physiologicalProperty:Temperature a skos:Concept ;
    skos:inScheme       physiologicalProperty:Scheme ;
    skos:broader        physiologicalProperty:PhysiologicalProperty ;
    rdfs:subClassOf     mda:PhysiologicalProperty ;
    skos:prefLabel      "Body temperature"@en, "Lichaamstemperatuur"@nl ;
    skos:definition     "The core temperature of the body, reflecting the balance of heat production and loss."@en,
                        "De kerntemperatuur van het lichaam, die de balans tussen warmteproductie en -verlies weerspiegelt."@nl ;
    skos:notation       "Temperature" .
