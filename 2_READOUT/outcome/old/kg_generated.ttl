alarmtype:CardiohelpPvenOnderWaarschuwingsgrens_Unknown a mda:AlarmType ;
    mda:hasCategory alarmcat:Physiological ;
    mda:hasLabel "CARDIOHELP - pVen onder waarschuwingsgrens"@en ;
    mda:hasMessage [ a mda:AlarmMessage ;
            mda:concernsPatient [ a mda:Patient ;
                    mda:isMonitoredBy [ a device:ExtracorporealMembraneOxygenator_CardioHelp_Getinge ;
                            mda:administers therapeuticModality:ExtraCorporeal_Membran_Oxygenation ;
                            mda:hasSensor [ a sensor:Pressure_transducer ;
                                    mda:detectsMetric [ a metric:VenousPressure ;
                                            mda:hasRate metricRate:Decreased ] ;
                                    mda:hasAnatomicalPosition anatomicalPosition:Venous ;
                                    mda:producesSignal [ a signal:Pressure_waveform ] ] ] ] ] ;
    mda:hasPriority alarmprio:Unknown .

