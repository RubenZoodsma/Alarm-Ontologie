####################################################################
# reduced_pulmonary_function.rq — clinical event ReducedPulmonaryFunction.
# HAND-AUTHORED.
#
# Criterion (FRAMEWORK/KNOWLEDGE_BASE/clinicalEvents.ttl, revised
# 2026-10-12 and 2026-11-25):
#   evidencedBy some
#     ( (metric:RespirationVolume_Minute and hasValueState Decreased or
#        narrower)
#    or (a metric approximating a property of PulmonaryOxygenation, with
#        hasValueState Decreased or narrower)
#    or (a metric approximating PaCO2, with hasValueState Increased or
#        narrower) )
# — a low minute volume, a low oxygenation (e.g. SpO2 laag, Desaturatie) or
# a raised arterial CO2 (e.g. etCO2 hoog), reported by a PHYSIOLOGICAL alarm
# of this patient that is still active and not CAT1-flagged. See cardiac_arrest.rq for the graphs: state from the
# alarm's transient graph, metric type from its own persistent graph.
#
# Clause by clause:
#   "decreased or narrower"    — the value-state hierarchy
#                                (mda:refinesConcept, hierarchy.ttl):
#                                Decreased itself, or SeverelyDecreased, so
#                                a severe desaturation counts as well. The
#                                direction is checked per branch: low for
#                                ventilation and oxygenation, high for CO2.
#   "low minute volume"        — RespirationVolume_Minute or a narrower
#                                pre-coordination of it (e.g. the
#                                expiratory minute volume, ServoU), via
#                                rdfs:subClassOf* (build_framework.py places
#                                each pre-coordinated concept under the less
#                                refined ones, 2026-11-25). Not the broader
#                                RespirationVolume (a low tidal volume alone
#                                can be rate-compensated). This is finer
#                                than CAT2a, which treats minute and tidal
#                                volume as one property (RespirationVolume):
#                                CAT2a asks whether an alarm adds
#                                information, this rule whether the patient
#                                is affected, and a CAT2 silence does not
#                                remove an alarm as evidence, so the two
#                                granularities never conflict.
#   "low oxygenation"          — concept level, as CAT2a: the metric's type
#                                or any superclass carries inference.ttl's
#                                class-level approximates restriction, and
#                                that property isPropertyOf
#                                PulmonaryOxygenation. Any device's
#                                oxygenation metric qualifies; no label or
#                                metric is named here.
#   "raised arterial CO2"      — (added 2026-11-25) hypercapnia, the direct
#                                marker of inadequate ventilation: not
#                                hidden by compensation, it is the failure
#                                of compensation. Concept level: any metric
#                                whose type (or a superclass) approximates
#                                physiologicalProperty:PaCO2 — the property
#                                itself, not its process (PulmonaryDiffusion
#                                also gathers what ECMO targets). In
#                                practice end-tidal CO2; inspired CO2 has no
#                                bridge, so rebreathing never counts.
#   "a physiological alarm"    — (added 2026-11-25) only the patient's
#                                condition is evidence ("we only care about
#                                impact"); a technical alarm reports device
#                                state, even if it carries a value.
#   Not admitted: low airway pressure (what a leak itself produces), low
#   end-tidal CO2, low respiratory rate, low tidal volume — see the
#   criterion's comment in clinicalEvents.ttl.
#   "not CAT1-flagged"         — a likely false positive (e.g. SpO2 laag on
#                                a weak signal) is no evidence.
#
# CONTRACT. Bound on entry: ?patient, ?now. Binds: ?evidence (the metric),
# ?support (the alarm's graph). Used by the episode actions.
#
# VALIDATION — engine/regression.py: cat3e, cat3b_leak, cat3b_cpap (minute
# volume); cat3b_spo2, cat3b_desat, fig2_scenario (oxygenation);
# rpf_hypercapnia (raised etCO2) fire; cat3b_spo2_flagged (flagged SpO2),
# cat3b_rr (low respiratory rate) and rpf_low_etco2 (low etCO2) do not.
####################################################################

PREFIX mda:        <https://w3id.org/mda/ontology#>
PREFIX mdapoc:     <https://w3id.org/mda/poc#>
PREFIX rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:       <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:        <http://www.w3.org/2002/07/owl#>
PREFIX metric:     <https://w3id.org/mda/vocab/metric/>
PREFIX valuestate: <https://w3id.org/mda/vocab/metric-value-state/>
PREFIX process:    <https://w3id.org/mda/vocab/physiological-process/>
PREFIX physiologicalProperty: <https://w3id.org/mda/vocab/physiological-property/>
PREFIX alarmcat:   <https://w3id.org/mda/vocab/alarm-category/>

GRAPH ?gEv { ?evAlarm mda:hasCategory alarmcat:Physiological .
             ?evAlarm mda:hasMessage ?evMsg . ?evMsg mda:concernsPatient ?patient .
             ?evidence mda:hasValueState ?state . }
BIND(IRI(CONCAT(STR(?evAlarm), "#persistent")) AS ?gEvP)
GRAPH ?gEvP { ?evidence rdf:type ?metricType . }
{
  # ventilation: a low minute volume (or a narrower pre-coordination of it)
  ?metricType rdfs:subClassOf* metric:RespirationVolume_Minute .
  ?state mda:refinesConcept* valuestate:Decreased .
} UNION {
  # oxygenation: a low value on any metric of a pulmonary-oxygenation property
  ?metricType rdfs:subClassOf* ?r . ?r owl:onProperty mda:approximates ; owl:hasValue ?property .
  ?property mda:isPropertyOf process:PulmonaryOxygenation .
  ?state mda:refinesConcept* valuestate:Decreased .
} UNION {
  # hypercapnia: a raised value on any metric approximating arterial CO2
  ?metricType rdfs:subClassOf* ?r . ?r owl:onProperty mda:approximates ; owl:hasValue physiologicalProperty:PaCO2 .
  ?state mda:refinesConcept* valuestate:Increased .
}
FILTER NOT EXISTS { GRAPH ?gEv { ?evAlarm mdapoc:flaggedLikelyFalsePositive ?why } }
BIND(?gEv AS ?support)
