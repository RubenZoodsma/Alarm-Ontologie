# silence_insert.rq — store a CAT2 silence in the silenced alarm's own
# transient graph (?tgraph): one silencedBy link per active alarm that
# justifies it, so the silence can be lifted when the last of them ends,
# and the same link under the rule's own sub-property (?ruleLink:
# mdapoc:silencedByCat2a / Cat2b), read back for the firing log by
# silence_readback.rq.
# Slots: {{BINDINGS}} ?alarm ?now ?tgraph ?ruleLink [?incomingPrio];
# {{CONDITION}} a CAT2 rule.

PREFIX mdapoc: <https://w3id.org/mda/poc#>

INSERT { GRAPH ?tgraph { ?alarm mdapoc:silencedBy ?active . ?alarm ?ruleLink ?active } }
WHERE { {{BINDINGS}} {{CONDITION}} }
