_:c14n158 a signal:ECG_lead_II ;
    mda:analyzedBy [ a signalAnalysis:STAnalysis ;
            mda:producesMetric [ a metric:STSegment ;
                    mda:approximates physiologicalProperty:MyocardialRepolarization ;
                    mda:hasValueState metricValueState:Increased ] ] .

_:c14n330 a signalAnalysis:EndDiastolicVolumeIndexAnalysis ;
    mda:producesMetric [ a metric:EndDiastolicVolumeIndex ;
            mda:hasValueState metricValueState:Increased ] .

_:c14n401 a metric:EndDiastolicVolume ;
    mda:hasValueState metricValueState:OutOfRange .

_:c14n73 a metric:EndDiastolicVolume ;
    mda:analyzedBy _:c14n330 .

_:c14n1517 a signalAnalysis:EndDiastolicVolumeAnalysis ;
    mda:producesMetric _:c14n401 .

_:c14n1547 a signalAnalysis:EndDiastolicVolumeAnalysis ;
    mda:producesMetric _:c14n73 .

_:c14n485 a signalAnalysis:ECG_derivation_II ;
    mda:producesSignal _:c14n158 .

