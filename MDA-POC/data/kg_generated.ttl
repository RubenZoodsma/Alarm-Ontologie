alarmtype:BabyLeo_MedibusAirTemperatureHigh_Medium a mda:AlarmType ;
    mda:hasCategory alarmcat:Technical ;
    mda:hasLabel "MEDIBUS - Air temperature high"@en ;
    mda:hasLabelConcept <https://w3id.org/mda/vocab/alarm-label/MedibusAirTemperatureHigh> ;
    mda:hasMessage [ a mda:AlarmMessage ;
            mda:concernsPatient [ a mda:Patient ] ;
            mda:triggeredBy [ a device:Incubator ;
                    mda:administers [ a therapeuticModality:ThermoRegulationTherapy ] ;
                    mda:hasDeviceType deviceType:BabyLeo ;
                    mda:hasFunctionalUnit [ a functionalUnit:FU_Temperature ;
                            mda:hasSensor [ a sensor:AirTemperature_sensor ;
                                    mda:sensorProducesSignal [ a signal:AirTemperature_signal ;
                                            mda:analyzedBy [ a signalAnalysis:AirTemperatureAnalysis ;
                                                    mda:producesMetric [ a metric:AirTemperature ;
                                                            mda:hasValueState metricValueState:Increased ] ] ] ] ] ;
                    mda:hasManufacturer manufacturer:Draeger ] ] ;
    mda:hasPriority alarmprio:Medium .

